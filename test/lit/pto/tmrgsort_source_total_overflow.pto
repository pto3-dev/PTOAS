// RUN: not ptoas --pto-arch=a3 --emit-pto-ir %s -o - 2>&1 | FileCheck %s
module {
  func.func @overflow(%source0: !pto.tile_buf<vec, 1x9223372036854775800xf32>, %source1: !pto.tile_buf<vec, 1x9223372036854775800xf32>, %result: !pto.tile_buf<vec, 1x64xf32>) {
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1 no_tmp {exhausted = false} : !pto.tile_buf<vec, 1x9223372036854775800xf32>, !pto.tile_buf<vec, 1x9223372036854775800xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}
// CHECK: format2 source column total is not representable
