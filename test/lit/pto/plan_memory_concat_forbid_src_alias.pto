// tconcat/tconcatidx widen the destination and shift every source element to a
// different byte offset, so the destination must never reuse a source address
// even though the sources die at the concat itself.

// RUN: ptoas --pto-level=level2 --pto-arch=a3 \
// RUN:   --emit-pto-ir --mlir-print-ir-after=pto-plan-memory %s 2>&1 \
// RUN:   | FileCheck %s

module attributes {"pto.target_arch" = "a3"} {
  func.func @plan_memory_tconcat_forbid_src_alias() {
    %src0 = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %src1 = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 16x32xf16>

    pto.tconcat ins(%src0, %src1 : !pto.tile_buf<vec, 16x16xf16>,
                                   !pto.tile_buf<vec, 16x16xf16>)
                outs(%dst : !pto.tile_buf<vec, 16x32xf16>)
    return
  }

  func.func @plan_memory_tconcatidx_forbid_src_alias() {
    %src0 = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %src1 = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %idx0 = pto.alloc_tile : !pto.tile_buf<vec, 16x16xi32>
    %idx1 = pto.alloc_tile : !pto.tile_buf<vec, 16x16xi32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 16x32xf16>

    pto.tconcatidx ins(%src0, %src1, %idx0, %idx1
                       : !pto.tile_buf<vec, 16x16xf16>,
                         !pto.tile_buf<vec, 16x16xf16>,
                         !pto.tile_buf<vec, 16x16xi32>,
                         !pto.tile_buf<vec, 16x16xi32>)
                   outs(%dst : !pto.tile_buf<vec, 16x32xf16>)
    return
  }
}

// CHECK-LABEL: func.func @plan_memory_tconcat_forbid_src_alias
// CHECK-DAG: %[[A0:.*]] = arith.constant 0 : i64
// CHECK-DAG: %[[A512:.*]] = arith.constant 512 : i64
// CHECK-DAG: %[[A1024:.*]] = arith.constant 1024 : i64
// CHECK: pto.alloc_tile addr = %[[A0]]
// CHECK: pto.alloc_tile addr = %[[A512]]
// CHECK: pto.alloc_tile addr = %[[A1024]]

// CHECK-LABEL: func.func @plan_memory_tconcatidx_forbid_src_alias
// CHECK-DAG: %[[B0:.*]] = arith.constant 0 : i64
// CHECK-DAG: %[[B512:.*]] = arith.constant 512 : i64
// CHECK-DAG: %[[B1024:.*]] = arith.constant 1024 : i64
// CHECK-DAG: %[[B2048:.*]] = arith.constant 2048 : i64
// CHECK-DAG: %[[B3072:.*]] = arith.constant 3072 : i64
// CHECK: pto.alloc_tile addr = %[[B0]]
// CHECK: pto.alloc_tile addr = %[[B512]]
// CHECK: pto.alloc_tile addr = %[[B1024]]
// CHECK: pto.alloc_tile addr = %[[B2048]]
// CHECK: pto.alloc_tile addr = %[[B3072]]
