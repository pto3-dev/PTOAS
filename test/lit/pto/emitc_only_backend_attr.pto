// REQUIRES: emitc-only-build
// RUN: not ptoas --pto-arch=a3 %s -o - 2>&1 | FileCheck %s
// RUN: ptoas --pto-arch=a3 --pto-backend=emitc %s -o - | FileCheck %s --check-prefix=OVERRIDE

module attributes {pto.backend = "vpto"} {
  func.func @backend_override() {
    return
  }
}

// CHECK: VPTO is unavailable in a PTOAS_EMITC_ONLY_BUILD compiler
// OVERRIDE: void backend_override()
