// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync %s | FileCheck %s

// Unknown ranges, wrapping arithmetic, equal slots, and incompatible views retain sync.
module {
  func.func @issue1587_same_slot(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 3 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_unrelated_indices(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %next = arith.remui %j, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_possible_wrap(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 1 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %i, %count : index
    %future = arith.addi %i, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_different_allocations(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %parent2 = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent2[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_partial_rows(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x32xf32>,
      %g1: !pto.partition_tensor_view<1x32xf32>,
      %out0: !pto.partition_tensor_view<1x32xf32>,
      %out1: !pto.partition_tensor_view<1x32xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 32] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x32xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 32] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x32xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x32xf32>) outs(%current : !pto.tile_buf<vec, 1x32xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x32xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x32xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x32xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x32xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x32xf32>) outs(%out0 : !pto.partition_tensor_view<1x32xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x32xf32>) outs(%out1 : !pto.partition_tensor_view<1x32xf32>)
    return
  }

  func.func @issue1587_unknown_row(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %next = arith.addi %i, %c0 : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_overlapping_rows(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<2x64xf32>,
      %g1: !pto.partition_tensor_view<2x64xf32>,
      %out0: !pto.partition_tensor_view<2x64xf32>,
      %out1: !pto.partition_tensor_view<2x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 1 : index
    %count = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [2, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 2x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [2, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 2x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<2x64xf32>) outs(%current : !pto.tile_buf<vec, 2x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<2x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 2x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 2x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 2x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 2x64xf32>) outs(%out0 : !pto.partition_tensor_view<2x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 2x64xf32>) outs(%out1 : !pto.partition_tensor_view<2x64xf32>)
    return
  }
}

