// RUN: not ptoas --pto-arch=a5 %s -o - 2>&1 | FileCheck %s --check-prefix=A5
// RUN: not ptoas --pto-arch=a3 %s -o - 2>&1 | FileCheck %s --check-prefix=A3

// Unsigned 8-bit form of `tpartmul_a5_i8_invalid.pto`: #1598 reports both i8 and
// ui8 as reaching the simulator as an unsupported `RV_VMUL` type (`type.U8`/
// `type.S8`).
module {
  func.func private @tpartmul_ui8(
      %src0: !pto.tile_buf<vec, 8x32xui8>, %src1: !pto.tile_buf<vec, 8x32xui8>,
      %dst: !pto.tile_buf<vec, 8x32xui8>) {
    pto.tpartmul ins(%src0, %src1 : !pto.tile_buf<vec, 8x32xui8>, !pto.tile_buf<vec, 8x32xui8>)
               outs(%dst : !pto.tile_buf<vec, 8x32xui8>)
    return
  }
}

// A5: error: 'pto.tpartmul' op expects A5 tpartmul element type to be i32/i16/f16/bf16/f32 (the A5 vmul profile has no i8/ui8 form)
// A3: error: 'pto.tpartmul' op expects A2/A3 tpartmul element type to be i32/i16/f16/f32
