// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync %s | FileCheck %s

// Distinct in-range rows must not delay current-row compute behind future-row loads.
module {
  func.func @issue1587_three_slots(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_two_slots(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 1 : index
    %count = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 2x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 2x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 2x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_four_slots(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 3 : index
    %count = arith.constant 4 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 4x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 4x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 4x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_byte_preserving_aliases(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<2x32xi32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1 : i32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %delta : index
    %next = arith.remui %future, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %cast = pto.bitcast %current : !pto.tile_buf<vec, 1x64xf32> -> !pto.tile_buf<vec, 1x64xi32>
    %alias = pto.treshape %cast : !pto.tile_buf<vec, 1x64xi32> -> !pto.tile_buf<vec, 2x32xi32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%alias, %one : !pto.tile_buf<vec, 2x32xi32>, i32) outs(%alias : !pto.tile_buf<vec, 2x32xi32>)
    pto.tstore ins(%alias : !pto.tile_buf<vec, 2x32xi32>) outs(%out0 : !pto.partition_tensor_view<2x32xi32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }

  func.func @issue1587_bounded_subtraction(%i: index, %j: index,
      %g0: !pto.partition_tensor_view<1x64xf32>,
      %g1: !pto.partition_tensor_view<1x64xf32>,
      %out0: !pto.partition_tensor_view<1x64xf32>,
      %out1: !pto.partition_tensor_view<1x64xf32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %base = arith.constant 0 : i64
    %c0 = arith.constant 0 : index
    %delta = arith.constant 2 : index
    %count = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %one = arith.constant 1.0 : f32
    %ordinal = arith.remui %i, %c64 : index
    %cur = arith.remui %ordinal, %count : index
    %future = arith.addi %ordinal, %count : index
    %previous = arith.subi %future, %delta : index
    %next = arith.remui %previous, %count : index
    %parent = pto.alloc_tile addr = %base : !pto.tile_buf<vec, 3x64xf32>
    %current = pto.subview %parent[%cur, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    %future_tile = pto.subview %parent[%next, %c0] sizes [1, 64] : !pto.tile_buf<vec, 3x64xf32> -> !pto.tile_buf<vec, 1x64xf32>
    pto.tload ins(%g0 : !pto.partition_tensor_view<1x64xf32>) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%g1 : !pto.partition_tensor_view<1x64xf32>) outs(%future_tile : !pto.tile_buf<vec, 1x64xf32>)
    pto.tadds ins(%current, %one : !pto.tile_buf<vec, 1x64xf32>, f32) outs(%current : !pto.tile_buf<vec, 1x64xf32>)
    pto.tstore ins(%current : !pto.tile_buf<vec, 1x64xf32>) outs(%out0 : !pto.partition_tensor_view<1x64xf32>)
    pto.tstore ins(%future_tile : !pto.tile_buf<vec, 1x64xf32>) outs(%out1 : !pto.partition_tensor_view<1x64xf32>)
    return
  }
}

// CHECK-LABEL: AICORE void issue1587_three_slots(
// CHECK: TLOAD(
// CHECK-NEXT: set_flag(PIPE_MTE2, PIPE_V, [[EVENT:EVENT_ID[0-9]+]]);
// CHECK: TLOAD(
// CHECK-NEXT: set_flag(PIPE_MTE2, PIPE_MTE3, [[STORE:EVENT_ID[0-9]+]]);
// CHECK: wait_flag(PIPE_MTE2, PIPE_V, [[EVENT]]);
// CHECK-NEXT: TADDS(
// CHECK: TSTORE(
// CHECK-NEXT: wait_flag(PIPE_MTE2, PIPE_MTE3, [[STORE]]);
// CHECK-NEXT: TSTORE(

// CHECK-LABEL: AICORE void issue1587_two_slots(
// CHECK: TLOAD(
