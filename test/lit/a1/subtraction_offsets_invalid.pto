// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/negative.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/negative.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/one_past.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/one_past.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/underflow.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/underflow.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/overflow.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/overflow.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/unknown.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/unknown.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// REJECT: A1 DMA

//--- negative.pto
module attributes {pto.target_arch = "a1"} {
  func.func @reject_negative(%out: !pto.ptr<f32>, %unknown: index) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %value = arith.constant 1.0 : f32
    %view = pto.make_tensor_view %out, shape = [%rows, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %zero to %rows step %one {
    %offset = arith.subi %i, %one : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}

//--- one_past.pto
module attributes {pto.target_arch = "a1"} {
  func.func @reject_one_past(%out: !pto.ptr<f32>, %unknown: index) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %value = arith.constant 1.0 : f32
    %view = pto.make_tensor_view %out, shape = [%rows, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %zero to %rows step %one {
    %a = arith.addi %i, %rows : index
    %offset = arith.subi %a, %one : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}

//--- underflow.pto
module attributes {pto.target_arch = "a1"} {
  func.func @reject_underflow(%out: !pto.ptr<f32>, %unknown: index) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %value = arith.constant 1.0 : f32
    %view = pto.make_tensor_view %out, shape = [%rows, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %zero to %rows step %one {
    %low = arith.constant -9223372036854775808 : index
    %a = arith.addi %low, %i : index
    %offset = arith.subi %a, %rows : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}

//--- overflow.pto
module attributes {pto.target_arch = "a1"} {
  func.func @reject_overflow(%out: !pto.ptr<f32>, %unknown: index) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %value = arith.constant 1.0 : f32
    %view = pto.make_tensor_view %out, shape = [%rows, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %zero to %rows step %one {
    %high = arith.constant 9223372036854775791 : index
    %neg = arith.constant -32 : index
    %a = arith.addi %high, %i : index
    %offset = arith.subi %a, %neg : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}

//--- unknown.pto
module attributes {pto.target_arch = "a1"} {
  func.func @reject_unknown(%out: !pto.ptr<f32>, %unknown: index) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %value = arith.constant 1.0 : f32
    %view = pto.make_tensor_view %out, shape = [%rows, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %zero to %rows step %one {
    %offset = arith.subi %i, %unknown : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}
