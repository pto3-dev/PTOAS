// CASE0: A1 merge requires full one-row FP32 Vec buffers
//--- fp16.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf16>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf16>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf16>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf16>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf16>, !pto.tile_buf<vec, 1x32xf16>, !pto.tile_buf<vec, 1x512xf16>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf16>, vector<4xi16>)
    return
  }
}

// CASE1: A1 merge sources require complete 16-pair groups
//--- source_tail.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x24xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x56xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x448xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x24xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x448xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x56xf32>, vector<4xi16>)
    return
  }
}

// CASE2: format2 expects src rows == 1
//--- source_rows.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 2x32xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x96xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x768xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 2x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x768xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x96xf32>, vector<4xi16>)
    return
  }
}

// CASE3: format2 expects dst/tmp rows == 1
//--- output_rows.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 2x32xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result, %counts : !pto.tile_buf<vec, 2x32xf32>, vector<4xi16>)
    return
  }
}

// CASE4: A1 merge destination cannot exceed the total source width
//--- output_too_wide.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
