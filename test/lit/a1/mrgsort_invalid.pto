// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 %t/blocklen.pto -o - 2>&1 | FileCheck %s --check-prefix=BLOCK
// BLOCK: A1 merge supports the multi-list form only
// RUN: not ptoas --pto-arch=a1 %t/fp16.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE0
// RUN: not ptoas --pto-arch=a1 %t/source_tail.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE1
// RUN: not ptoas --pto-arch=a1 %t/source_rows.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE2
