    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x72xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x72xf32>, vector<4xi16>)
    return
  }
}

// CASE5: A1 merge scratch requires two eight-field proposal banks
//--- scratch_short.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x504xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x504xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

// CASE6: format2 expects dst/tmp element types to match
//--- scratch_dtype.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x1024xf16>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x1024xf16>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

// CASE7: 128 KiB UB budget
//--- scratch_ub.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x32776xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32776xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

// CASE8: A1 merge proposal scratch exceeds the 128 KiB UB budget
//--- source_total_ub.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x2080xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x2080xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1 no_tmp {exhausted = true} : !pto.tile_buf<vec, 1x2080xf32>, !pto.tile_buf<vec, 1x2080xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

// CASE9: A1 vector lowering requires static full row-major
//--- partial.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

// CASE10: format2 excuted must be vector<4xi16>
//--- status_type.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %counts = arith.constant dense<0> : vector<4xi32>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi32>)
    return
  }
}

// CASE11: requires explicit tmp for tmrgsort format2 when PlanMemory is skipped
//--- level3_implicit.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0_addr = arith.constant 0 : i64
    %source0 = pto.alloc_tile addr = %source0_addr : !pto.tile_buf<vec, 1x32xf32>
    %source1_addr = arith.constant 8192 : i64
    %source1 = pto.alloc_tile addr = %source1_addr : !pto.tile_buf<vec, 1x32xf32>
    %result_addr = arith.constant 16384 : i64
    %result = pto.alloc_tile addr = %result_addr : !pto.tile_buf<vec, 1x64xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1 no_tmp {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

// CASE12: A1 merge requires disjoint writable buffers
//--- alias_2_0.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source0_addr = arith.constant 0 : i64
    %source0 = pto.alloc_tile addr = %source0_addr : !pto.tile_buf<vec, 1x32xf32>
    %source1_addr = arith.constant 8192 : i64
    %source1 = pto.alloc_tile addr = %source1_addr : !pto.tile_buf<vec, 1x32xf32>
    %result_addr = arith.constant 32 : i64
    %result = pto.alloc_tile addr = %result_addr : !pto.tile_buf<vec, 1x64xf32>
    %scratch_addr = arith.constant 73728 : i64
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x512xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x64xf32>, vector<4xi16>)
    return
  }
}

