// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/initialize.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/initialize.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/initialize.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/padding.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level2 %t/padding.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/padding.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=REJECT
// REJECT: A1 load padding and initialization modes are unavailable.

//--- initialize.pto
module attributes {pto.target_arch = "a1"} {
  func.func @a1_cache_reject_initialize(%src: !pto.ptr<f16>, %out: !pto.ptr<f16>, %alias: i64) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %cols = arith.constant 16 : index
    %src_view = pto.make_tensor_view %src, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %src_part = pto.partition_view %src_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x16xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x16xf16>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf16>
    pto.tload ins(%src_part : !pto.partition_tensor_view<1x16xf16>) outs(%a : !pto.tile_buf<vec, 1x16xf16>) {cache_policy = #pto.load_cache_policy<l2_bypass>, init_out_buffer = true} offset = %alias : i64
    pto.tstore ins(%a : !pto.tile_buf<vec, 1x16xf16>) outs(%out_part : !pto.partition_tensor_view<1x16xf16>)
    // Reusing the same source must keep its original descriptor and address.
    pto.tload ins(%src_part : !pto.partition_tensor_view<1x16xf16>) outs(%a : !pto.tile_buf<vec, 1x16xf16>) {cache_policy = #pto.load_cache_policy<default>}
    pto.tstore ins(%a : !pto.tile_buf<vec, 1x16xf16>) outs(%out_part : !pto.partition_tensor_view<1x16xf16>)
    return
  }
}

//--- padding.pto
module attributes {pto.target_arch = "a1"} {
  func.func @a1_cache_reject_padding(%src: !pto.ptr<f16>, %out: !pto.ptr<f16>, %alias: i64) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %cols = arith.constant 16 : index
    %src_view = pto.make_tensor_view %src, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %src_part = pto.partition_view %src_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x16xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x16xf16>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf16>
    pto.tload ins(%src_part : !pto.partition_tensor_view<1x16xf16>) outs(%a : !pto.tile_buf<vec, 1x16xf16>) {cache_policy = #pto.load_cache_policy<l2_bypass>, pad_mode = #pto.padmode<PadNull>} offset = %alias : i64
    pto.tstore ins(%a : !pto.tile_buf<vec, 1x16xf16>) outs(%out_part : !pto.partition_tensor_view<1x16xf16>)
    // Reusing the same source must keep its original descriptor and address.
    pto.tload ins(%src_part : !pto.partition_tensor_view<1x16xf16>) outs(%a : !pto.tile_buf<vec, 1x16xf16>) {cache_policy = #pto.load_cache_policy<default>}
    pto.tstore ins(%a : !pto.tile_buf<vec, 1x16xf16>) outs(%out_part : !pto.partition_tensor_view<1x16xf16>)
    return
  }
}
