// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @unbounded_l1_slot(%slot: index) attributes {pto.entry} {
    %c512 = arith.constant 512 : index
    %offset = arith.muli %slot, %c512 : index
    %addr = arith.index_cast %offset : index to i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    return
  }
}
// CHECK: A1 Mat tile address must be bounded, aligned and within its L1 memory budget
