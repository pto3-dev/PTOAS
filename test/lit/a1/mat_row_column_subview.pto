// RUN: sed 's/ addr = [^ ]*//g' %s > %t.pto
// RUN: ptoas --pto-arch=a1 --pto-level=level1 %t.pto -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %t.pto -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @last_c16_fractal() {
    %source_addr = arith.constant 512 : i64
    %zero_addr = arith.constant 0 : i64
    %row = arith.constant 48 : index
    %column = arith.constant 80 : index
    %source = pto.alloc_tile addr = %source_addr : !pto.tile_buf<mat, 64x96xf16, blayout=col_major, slayout=row_major, fractal=512>
    %view = pto.subview %source[%row, %column] sizes [16, 16] : !pto.tile_buf<mat, 64x96xf16, blayout=col_major, slayout=row_major, fractal=512> -> !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile addr = %zero_addr : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=row_major, fractal=512>
    pto.tmov ins(%view : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%left : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=row_major, fractal=512>)
    return
  }
  func.func @last_two_row_fractals() {
    %source_addr = arith.constant 512 : i64
    %zero_addr = arith.constant 0 : i64
    %row = arith.constant 96 : index
    %column = arith.constant 48 : index
    %source = pto.alloc_tile addr = %source_addr : !pto.tile_buf<mat, 128x64xf16, blayout=col_major, slayout=row_major, fractal=512>
    %view = pto.subview %source[%row, %column] sizes [32, 16] : !pto.tile_buf<mat, 128x64xf16, blayout=col_major, slayout=row_major, fractal=512> -> !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile addr = %zero_addr : !pto.tile_buf<left, 32x16xf16, blayout=row_major, slayout=row_major, fractal=512>
    pto.tmov ins(%view : !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%left : !pto.tile_buf<left, 32x16xf16, blayout=row_major, slayout=row_major, fractal=512>)
    return
  }

}
// CHECK-LABEL: last_c16_fractal
// CHECK: Tile<TileType::Mat, half, 16, 16
// CHECK: TMOV(
// CHECK-LABEL: last_two_row_fractals
// CHECK: Tile<TileType::Mat, half, 32, 16
// CHECK: TMOV(
