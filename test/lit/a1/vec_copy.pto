// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_vec_copy(%out: !pto.ptr<f32>, %in: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 13 : index
    %cols = arith.constant 80 : index
    %iv = pto.make_tensor_view %in, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ov = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ip = pto.partition_view %iv, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<13x80xf32>
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<13x80xf32>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 13x80xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 13x80xf32>
    pto.tload ins(%ip : !pto.partition_tensor_view<13x80xf32>) outs(%src : !pto.tile_buf<vec, 13x80xf32>)
    pto.tmov ins(%src : !pto.tile_buf<vec, 13x80xf32>) outs(%dst : !pto.tile_buf<vec, 13x80xf32>)
    pto.tstore ins(%dst : !pto.tile_buf<vec, 13x80xf32>) outs(%op : !pto.partition_tensor_view<13x80xf32>)
    return
  }
}
// CHECK-LABEL: a1_vec_copy(
// CHECK: set_flag(PIPE_MTE2, PIPE_V,
// CHECK: TMOV(
// CHECK: set_flag(PIPE_V, PIPE_MTE3,
// CHECK: TSTORE(
// CHECK-NOT: PIPE_FIX
