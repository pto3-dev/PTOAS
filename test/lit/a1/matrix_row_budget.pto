// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %s 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %addr = arith.constant 512 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<left, 2048x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    return
  }
}
// CHECK: A1 matrix tile address must be static, aligned and within its memory budget
