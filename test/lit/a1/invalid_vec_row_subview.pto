// RUN: not ptoas --pto-arch=a1 %s -o /dev/null 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %row = arith.constant 3 : index
    %zero = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<vec, 15x80xf32>
    %bad = pto.subview %src[%row, %zero] sizes [13, 80] : !pto.tile_buf<vec, 15x80xf32> -> !pto.tile_buf<vec, 13x80xf32>
    return
  }
}
// CHECK: A1 Vec subviews require a bounded full-width static row interval
