// RUN: not ptoas --pto-arch=a1 %s 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 %s 2>&1 | FileCheck %s --check-prefix=A3
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    pto.tmov ins(%src : !pto.tile_buf<vec, 16x16xf32>) outs(%dst : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    return
  }
}
// CHECK: A1 Vec-to-Mat moves require matching full FP16 tiles
// A3: expects a supported tmov address-space pair for this target
