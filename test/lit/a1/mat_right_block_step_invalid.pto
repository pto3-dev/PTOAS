//--- zero_step.pto
// NEG0: A1 block_step must be in
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {
    %row = arith.constant 1776 : index
    %col = arith.constant 0 : index
    pto.textract ins(%s, %row, %col : !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%d : !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {block_step = 0 : i64}
    return
  }
}

//--- negative_step.pto
// NEG1: A1 block_step must be in
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {
