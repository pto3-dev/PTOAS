  func.func @invalid(%s: !pto.tile_buf<mat, 32784x16xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<right, 144x16xf16, blayout=row_major, slayout=col_major, fractal=512>) {
    %row = arith.constant 0 : index
    %col = arith.constant 0 : index
    pto.textract ins(%s, %row, %col : !pto.tile_buf<mat, 32784x16xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%d : !pto.tile_buf<right, 144x16xf16, blayout=row_major, slayout=col_major, fractal=512>) {block_step = 4 : i64}
    return
  }
}

//--- target_l0b_budget.pto
