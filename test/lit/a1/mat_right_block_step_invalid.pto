//--- wrong_target_space.pto
// NEG19: A1 extraction supports FP16 Mat-to-Right operands only
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<left, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {
