// RUN: not ptoas --pto-arch=a5 %t/a5_attribute.pto -o %t/a5_attribute.cpp 2>&1 | FileCheck %s --check-prefix=NEG24
// RUN: not ptoas --pto-arch=a1 %t/ordinary_unaligned.pto -o %t/ordinary_unaligned.cpp 2>&1 | FileCheck %s --check-prefix=NEG25
