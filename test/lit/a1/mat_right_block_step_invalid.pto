    pto.textract ins(%s, %row, %col : !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%d : !pto.tile_buf<left, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {block_step = 4 : i64}
    return
  }
}

