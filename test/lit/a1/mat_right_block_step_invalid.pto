}

//--- unknown_row.pto
// NEG8: A1 extraction requires bounded C16-aligned source offsets
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>, %row: index) {
    %col = arith.constant 0 : index
    pto.textract ins(%s, %row, %col : !pto.tile_buf<mat, 2304x32xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%d : !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {block_step = 4 : i64}
    return
  }
}

//--- unknown_col.pto
