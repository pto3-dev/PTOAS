  func.func @invalid(%s: !pto.tile_buf<mat, 2304x64xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>, %col: index) {
