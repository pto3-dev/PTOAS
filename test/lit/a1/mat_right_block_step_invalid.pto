//--- partial_source.pto
// NEG22: A1 extraction requires full static
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<loc=mat, dtype=f16, rows=2304, cols=32, v_row=2288, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>, %d: !pto.tile_buf<right, 144x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {
