// RUN: not ptoas --pto-arch=a1 %t/unaligned_col.pto -o %t/unaligned_col.cpp 2>&1 | FileCheck %s --check-prefix=NEG7
// RUN: not ptoas --pto-arch=a1 %t/unknown_row.pto -o %t/unknown_row.cpp 2>&1 | FileCheck %s --check-prefix=NEG8
// RUN: not ptoas --pto-arch=a1 %t/unknown_col.pto -o %t/unknown_col.cpp 2>&1 | FileCheck %s --check-prefix=NEG9
// RUN: not ptoas --pto-arch=a1 %t/negative_row.pto -o %t/negative_row.cpp 2>&1 | FileCheck %s --check-prefix=NEG10
// RUN: not ptoas --pto-arch=a1 %t/negative_col.pto -o %t/negative_col.cpp 2>&1 | FileCheck %s --check-prefix=NEG11
// RUN: not ptoas --pto-arch=a1 %t/row_overflow.pto -o %t/row_overflow.cpp 2>&1 | FileCheck %s --check-prefix=NEG12
// RUN: not ptoas --pto-arch=a1 %t/col_overflow.pto -o %t/col_overflow.cpp 2>&1 | FileCheck %s --check-prefix=NEG13
