// RUN: not ptoas --pto-arch=a1 %t/target_l0b_budget.pto -o %t/target_l0b_budget.cpp 2>&1 | FileCheck %s --check-prefix=NEG15
// RUN: not ptoas --pto-arch=a1 %t/large_target_rows.pto -o %t/large_target_rows.cpp 2>&1 | FileCheck %s --check-prefix=NEG16
// RUN: not ptoas --pto-arch=a1 %t/wide_target.pto -o %t/wide_target.cpp 2>&1 | FileCheck %s --check-prefix=NEG17
