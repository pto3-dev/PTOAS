  func.func @invalid(%s: !pto.tile_buf<mat, 4096x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<right, 2048x32xf16, blayout=row_major, slayout=col_major, fractal=512>) {
