}

// CASE9: src and dst to have the same element type
//--- gather_invalid_value_dtype.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 8x80xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 8x96xi32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 8x192xi32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 8x96xf16>
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>, !pto.tile_buf<vec, 8x192xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf16>)
    return
  }
}

// CASE10: A1 indexed gather requires disjoint writable buffers.
//--- gather_alias_0.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_address = arith.constant 0 : i64
    %source = pto.alloc_tile addr = %source_address : !pto.tile_buf<vec, 8x80xf32>
    %indices_address = arith.constant 4096 : i64
    %indices = pto.alloc_tile addr = %indices_address : !pto.tile_buf<vec, 8x96xi32>
    %scratch_address = arith.constant 8192 : i64
    %scratch = pto.alloc_tile addr = %scratch_address : !pto.tile_buf<vec, 8x192xi32>
    %result_address = arith.constant 32 : i64
    %result = pto.alloc_tile addr = %result_address : !pto.tile_buf<vec, 8x96xf32>
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>, !pto.tile_buf<vec, 8x192xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
  }
}

// CASE11: A1 indexed gather requires disjoint writable buffers.
//--- gather_alias_1.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_address = arith.constant 0 : i64
    %source = pto.alloc_tile addr = %source_address : !pto.tile_buf<vec, 8x80xf32>
    %indices_address = arith.constant 4096 : i64
    %indices = pto.alloc_tile addr = %indices_address : !pto.tile_buf<vec, 8x96xi32>
    %scratch_address = arith.constant 8192 : i64
    %scratch = pto.alloc_tile addr = %scratch_address : !pto.tile_buf<vec, 8x192xi32>
    %result_address = arith.constant 4128 : i64
    %result = pto.alloc_tile addr = %result_address : !pto.tile_buf<vec, 8x96xf32>
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>, !pto.tile_buf<vec, 8x192xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
  }
}

// CASE12: A1 indexed gather requires disjoint writable buffers.
//--- gather_alias_2.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_address = arith.constant 0 : i64
    %source = pto.alloc_tile addr = %source_address : !pto.tile_buf<vec, 8x80xf32>
    %indices_address = arith.constant 4096 : i64
    %indices = pto.alloc_tile addr = %indices_address : !pto.tile_buf<vec, 8x96xi32>
    %scratch_address = arith.constant 32 : i64
    %scratch = pto.alloc_tile addr = %scratch_address : !pto.tile_buf<vec, 8x192xi32>
    %result_address = arith.constant 16384 : i64
    %result = pto.alloc_tile addr = %result_address : !pto.tile_buf<vec, 8x96xf32>
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>, !pto.tile_buf<vec, 8x192xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
  }
}

