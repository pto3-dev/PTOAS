    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>, !pto.tile_buf<vec, 8x192xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
