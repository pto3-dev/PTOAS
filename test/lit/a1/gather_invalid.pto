module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 8x80xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 8x96xi32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 8x192xui32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 8x96xf32>
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>, !pto.tile_buf<vec, 8x192xui32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
  }
}

// CASE8: dst and indices to have the same valid_shape
//--- gather_invalid_shape.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 8x80xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 7x96xi32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 8x192xi32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 8x96xf32>
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 7x96xi32>, !pto.tile_buf<vec, 8x192xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
