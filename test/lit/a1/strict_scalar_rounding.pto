// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_strict_scalar(%out: !pto.ptr<f32>, %input: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 16 : index
    %in_view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %out_view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %in_part = pto.partition_view %in_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%in_part : !pto.partition_tensor_view<16x16xf32>) outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    pto.tadd ins(%a, %a : !pto.tile_buf<vec, 16x16xf32>, !pto.tile_buf<vec, 16x16xf32>) outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    %factor = arith.constant 1.4426950408889634 : f32
    %half = arith.constant 0.5 : f32
    %izero = arith.constant 0 : i32
    scf.for %row = %zero to %rows step %one {
      %base = arith.muli %row, %cols : index
      %col = arith.addi %base, %one : index
      %v = pto.tgetval ins(%a, %col : !pto.tile_buf<vec, 16x16xf32>, index) outs : f32
      %scaled = arith.mulf %v, %factor : f32
      %shifted = arith.subf %scaled, %half : f32
      %n = arith.fptosi %shifted : f32 to i32
      %neg = arith.subi %izero, %n : i32
      %result = arith.sitofp %neg : i32 to f32
      pto.tsetval ins(%base, %result : index, f32) outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    }
    pto.tadd ins(%a, %a : !pto.tile_buf<vec, 16x16xf32>, !pto.tile_buf<vec, 16x16xf32>) outs(%a : !pto.tile_buf<vec, 16x16xf32>)
    pto.tstore ins(%a : !pto.tile_buf<vec, 16x16xf32>) outs(%out_part : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}
// CHECK: a1_strict_scalar(
// CHECK: float [[INPUT:[_A-Za-z0-9]+]] = {{.*}}.GetValue(
// CHECK: float [[SCALED:[_A-Za-z0-9]+]] = [[INPUT]] * {{.*}};
// CHECK: float [[SHIFTED:[_A-Za-z0-9]+]] = [[SCALED]] - {{.*}};
// CHECK: int32_t [[CAST:[_A-Za-z0-9]+]] = (int32_t) [[SHIFTED]];
// CHECK: {{^ *}}int32_t [[NEG:[_A-Za-z0-9]+]] = {{.*}}[[CAST]]{{.*}};
// CHECK: float [[FLOAT:[_A-Za-z0-9]+]] = (float) [[NEG]];
// CHECK: .SetValue({{.*}}, [[FLOAT]])
