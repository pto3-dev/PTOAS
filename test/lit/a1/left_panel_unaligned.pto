// RUN: not ptoas --pto-arch=a1 %s 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %zero = arith.constant 0 : index
    %column = arith.constant 8 : index
    %src = pto.alloc_tile : !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %dst = pto.alloc_tile : !pto.tile_buf<left, 32x64xf16, blayout=row_major, slayout=row_major, fractal=512>
    pto.tinsert ins(%src, %zero, %column : !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%dst : !pto.tile_buf<left, 32x64xf16, blayout=row_major, slayout=row_major, fractal=512>)
    return
  }
}
// CHECK: bounded aligned offsets
