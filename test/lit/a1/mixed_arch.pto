// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module {
  module attributes {pto.target_arch = "a5"} {
    func.func @bad_child() { return }
  }
}
// CHECK: A1 lowering does not support mixed target architectures
