// RUN: ptoas --emit-pto-ir %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a3 --emit-pto-ir %s -o - | FileCheck %s --check-prefix=OVERRIDE
// RUN: not ptoas --pto-arch=a1 --pto-backend=vpto %s -o - 2>&1 | FileCheck %s --check-prefix=VPTO
module attributes {"pto.device-spec" = "Ascend310P3"} {
  func.func @target_selection() { return }
}
// CHECK: pto.target_arch = "a1"
// OVERRIDE: pto.target_arch = "a3"
// VPTO: A1 currently supports only the EmitC backend
