// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 %t/source_ub_budget.pto -o %t/source_ub_budget.cpp 2>&1 | FileCheck %s --check-prefix=UB
// RUN: not ptoas --pto-arch=a1 %t/l0_rows.pto -o %t/l0_rows.cpp 2>&1 | FileCheck %s --check-prefix=L0
// RUN: not ptoas --pto-arch=a1 %t/case0.pto -o %t/case0.cpp 2>&1 | FileCheck %s --check-prefix=NEG0
// RUN: not ptoas --pto-arch=a1 %t/case1.pto -o %t/case1.cpp 2>&1 | FileCheck %s --check-prefix=NEG1
// RUN: not ptoas --pto-arch=a1 %t/case2.pto -o %t/case2.cpp 2>&1 | FileCheck %s --check-prefix=NEG2
// RUN: not ptoas --pto-arch=a1 %t/case3.pto -o %t/case3.cpp 2>&1 | FileCheck %s --check-prefix=NEG3
// RUN: not ptoas --pto-arch=a1 %t/case4.pto -o %t/case4.cpp 2>&1 | FileCheck %s --check-prefix=NEG4
// RUN: not ptoas --pto-arch=a1 %t/case5.pto -o %t/case5.cpp 2>&1 | FileCheck %s --check-prefix=NEG5
// RUN: not ptoas --pto-arch=a1 %t/case6.pto -o %t/case6.cpp 2>&1 | FileCheck %s --check-prefix=NEG6
// RUN: not ptoas --pto-arch=a1 %t/case7.pto -o %t/case7.cpp 2>&1 | FileCheck %s --check-prefix=NEG7
// RUN: not ptoas --pto-arch=a1 %t/case8.pto -o %t/case8.cpp 2>&1 | FileCheck %s --check-prefix=NEG8
// RUN: not ptoas --pto-arch=a1 %t/case9.pto -o %t/case9.cpp 2>&1 | FileCheck %s --check-prefix=NEG9
// RUN: not ptoas --pto-arch=a1 %t/case10.pto -o %t/case10.cpp 2>&1 | FileCheck %s --check-prefix=NEG10
// RUN: not ptoas --pto-arch=a1 %t/case11.pto -o %t/case11.cpp 2>&1 | FileCheck %s --check-prefix=NEG11
// RUN: not ptoas --pto-arch=a1 %t/case12.pto -o %t/case12.cpp 2>&1 | FileCheck %s --check-prefix=NEG12
// RUN: not ptoas --pto-arch=a1 %t/case13.pto -o %t/case13.cpp 2>&1 | FileCheck %s --check-prefix=NEG13
// RUN: not ptoas --pto-arch=a1 %t/case14.pto -o %t/case14.cpp 2>&1 | FileCheck %s --check-prefix=NEG14
// RUN: not ptoas --pto-arch=a3 %t/case15.pto -o %t/case15.cpp 2>&1 | FileCheck %s --check-prefix=NEG15
// RUN: not ptoas --pto-arch=a5 %t/case16.pto -o %t/case16.cpp 2>&1 | FileCheck %s --check-prefix=NEG16
// RUN: not ptoas --pto-arch=a1 %t/case17.pto -o %t/case17.cpp 2>&1 | FileCheck %s --check-prefix=NEG17
// RUN: not ptoas --pto-arch=a1 %t/case18.pto -o %t/case18.cpp 2>&1 | FileCheck %s --check-prefix=NEG18

//--- case0.pto
// NEG0: expects indexRow to be non-negative
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<vec, 16x32xf16>, %d: !pto.tile_buf<mat, 2304x64xf16, blayout=col_major, slayout=row_major, fractal=512>) {
    %row = arith.constant -1 : index
    %col = arith.constant 16 : index
    pto.tinsert ins(%s, %row, %col : !pto.tile_buf<vec, 16x32xf16>, index, index) outs(%d : !pto.tile_buf<mat, 2304x64xf16, blayout=col_major, slayout=row_major, fractal=512>) {row_step = 145 : i64}
    return
  }
}

//--- case1.pto
// NEG1: expects indexCol to be non-negative
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<vec, 16x32xf16>, %d: !pto.tile_buf<mat, 2304x64xf16, blayout=col_major, slayout=row_major, fractal=512>) {
    %row = arith.constant 128 : index
    %col = arith.constant -1 : index
    pto.tinsert ins(%s, %row, %col : !pto.tile_buf<vec, 16x32xf16>, index, index) outs(%d : !pto.tile_buf<mat, 2304x64xf16, blayout=col_major, slayout=row_major, fractal=512>) {row_step = 145 : i64}
    return
  }
}

