//--- case18.pto
// NEG18: memory budget
module attributes {pto.target_arch = "a1"} {
  func.func @invalid(%s: !pto.tile_buf<vec, 16x16xf16>, %d: !pto.tile_buf<mat, 4611686018427387904x16xf16, blayout=col_major, slayout=row_major, fractal=512>) {
    %row = arith.constant 128 : index
    %col = arith.constant 0 : index
    pto.tinsert ins(%s, %row, %col : !pto.tile_buf<vec, 16x16xf16>, index, index) outs(%d : !pto.tile_buf<mat, 4611686018427387904x16xf16, blayout=col_major, slayout=row_major, fractal=512>) {row_step = 145 : i64}
    return
