}

//--- source_ub_budget.pto
// UB: operands exceed their memory budget
module attributes {pto.target_arch = "a1"} {
  func.func @invalid_source_budget(%s: !pto.tile_buf<vec, 4097x16xf16>, %d: !pto.tile_buf<mat, 8192x16xf16, blayout=col_major, slayout=row_major, fractal=512>) {
    %zero = arith.constant 0 : index
    pto.tinsert ins(%s, %zero, %zero : !pto.tile_buf<vec, 4097x16xf16>, index, index) outs(%d : !pto.tile_buf<mat, 8192x16xf16, blayout=col_major, slayout=row_major, fractal=512>) {row_step = 1 : i64}
    return
  }
}

//--- l0_rows.pto
// L0: only resident Mat rows may exceed 2048
module attributes {pto.target_arch = "a1"} {
  func.func @invalid_l0_rows(%s: !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>, %d: !pto.tile_buf<left, 2304x16xf16, blayout=row_major, slayout=row_major, fractal=512>) {
    %zero = arith.constant 0 : index
    pto.tinsert ins(%s, %zero, %zero : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%d : !pto.tile_buf<left, 2304x16xf16, blayout=row_major, slayout=row_major, fractal=512>)
    return
  }
}
