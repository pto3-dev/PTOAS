// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: ptoas %s -o - | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @a1_f16_muls(%out: !pto.ptr<f16>, %input: !pto.ptr<f16>, %factor: f16) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 4 : index
    %cols = arith.constant 16 : index
    %input_view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %output_view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %input_part = pto.partition_view %input_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<4x16xf16>
    %output_part = pto.partition_view %output_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<4x16xf16>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 4x16xf16>
    %b = pto.alloc_tile : !pto.tile_buf<vec, 4x16xf16>
    pto.tload ins(%input_part : !pto.partition_tensor_view<4x16xf16>) outs(%a : !pto.tile_buf<vec, 4x16xf16>)
    pto.tmuls ins(%a, %factor : !pto.tile_buf<vec, 4x16xf16>, f16) outs(%b : !pto.tile_buf<vec, 4x16xf16>)
    pto.tstore ins(%b : !pto.tile_buf<vec, 4x16xf16>) outs(%output_part : !pto.partition_tensor_view<4x16xf16>)
    return
  }
}

// CHECK: a1_f16_muls(
// CHECK: Tile<TileType::Vec, half, 4, 16,
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_V,
// CHECK: TMULS(
// CHECK: TSTORE(
