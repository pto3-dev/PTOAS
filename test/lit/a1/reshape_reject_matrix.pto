// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module {
  func.func @bad_reshape() {
    %a = pto.alloc_tile : !pto.tile_buf<mat, 16x16xf16, slayout=row_major>
    %b = pto.treshape %a : !pto.tile_buf<mat, 16x16xf16, slayout=row_major> -> !pto.tile_buf<mat, 16x16xf16, slayout=row_major>
    return
  }
}
// CHECK: A1 reshape requires row-major Vec views with matching element types and counts.
