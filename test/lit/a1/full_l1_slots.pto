// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
// Explicit addresses belong to level3; exercise the final aligned slots.
module attributes {pto.target_arch = "a1"} {
  func.func @a1_last_l1_slot(%input: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 16 : index
    %address = arith.constant 1048064 : i64
    %tv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %part = pto.partition_view %tv, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    %image = pto.alloc_tile addr = %address : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%image : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    return
  }
  func.func @a1_upper_l1_slots(%input: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %sixteen = arith.constant 16 : index
    %step = arith.constant 512 : index
    %base = arith.constant 1047552 : index
    %tv = pto.make_tensor_view %input, shape = [%sixteen, %sixteen], strides = [%sixteen, %one] : !pto.tensor_view<?x?xf16>
    %part = pto.partition_view %tv, offsets = [%zero, %zero], sizes = [%sixteen, %sixteen] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    scf.for %slot = %zero to %two step %one {
      %offset = arith.muli %slot, %step : index
      %address = arith.addi %base, %offset : index
      %address_i64 = arith.index_cast %address : index to i64
      %image = pto.alloc_tile addr = %address_i64 : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>
      pto.tload ins(%part : !pto.partition_tensor_view<16x16xf16>) outs(%image : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    }
    return
  }
}
// CHECK-LABEL: a1_last_l1_slot
// CHECK: 1048064
// CHECK: TLOAD(
// CHECK-LABEL: a1_upper_l1_slots
// CHECK: TLOAD(
