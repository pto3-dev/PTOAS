// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @integer_column() {
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 64x1xi32, blayout=col_major>
    return
  }
}
// CHECK: A1 integer DMA requires full row-major Vec storage.
