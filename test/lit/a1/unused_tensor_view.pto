// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @flat_alias(%input: !pto.ptr<f32>, %output: !pto.ptr<f32>) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 128 : index
    %cols = arith.constant 16 : index
    %block = pto.get_block_idx
    %index = arith.index_cast %block : i64 to index
    %offset = arith.muli %index, %cols : index
    %flat = arith.constant 2048 : index
    %unused = pto.make_tensor_view %input, shape = [%flat], strides = [%one] : !pto.tensor_view<?xf32>
    %in = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %out = pto.make_tensor_view %output, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %src = pto.partition_view %in, offsets = [%offset, %zero], sizes = [%cols, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %dst = pto.partition_view %out, offsets = [%offset, %zero], sizes = [%cols, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%src : !pto.partition_tensor_view<16x16xf32>) outs(%tile : !pto.tile_buf<vec, 16x16xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf32>) outs(%dst : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}
// CHECK: get_block_idx()
// CHECK: TLOAD(
// CHECK: TSTORE(
