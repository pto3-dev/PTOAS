// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @signed_division_rows(%out: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 8 : index
    %begin = arith.constant 0 : index
    %end = arith.constant 64 : index
    %factor = arith.constant 16 : index
    %value = arith.constant 0.0 : f32
    %denominator = arith.constant 4 : index
    %view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %begin to %end step %one {
      %offset = arith.divsi %i, %denominator : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
  func.func @unsigned_division_rows(%out: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 8 : index
    %begin = arith.constant 0 : index
    %end = arith.constant 64 : index
    %factor = arith.constant 16 : index
    %value = arith.constant 0.0 : f32
    %denominator = arith.constant 4 : index
    %view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %begin to %end step %one {
      %offset = arith.divui %i, %denominator : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
  func.func @divisible_column_offsets(%out: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 1 : index
    %cols = arith.constant 64 : index
    %begin = arith.constant 0 : index
    %end = arith.constant 8 : index
    %factor = arith.constant 16 : index
    %value = arith.constant 0.0 : f32
    %denominator = arith.constant 2 : index
    %view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    scf.for %i = %begin to %end step %one {
      %numerator = arith.muli %i, %factor : index
      %offset = arith.divsi %numerator, %denominator : index
      %part = pto.partition_view %view, offsets = [%zero, %offset], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }
}

// CHECK: signed_division_rows(
// CHECK: TSTORE(
// CHECK: unsigned_division_rows(
// CHECK: TSTORE(
// CHECK: divisible_column_offsets(
// CHECK: TSTORE(
