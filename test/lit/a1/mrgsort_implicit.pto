// RUN: ptoas --pto-arch=a1 --emit-pto-ir %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s --check-prefix=CPP
module attributes {pto.target_arch = "a1"} {
  func.func @implicit_merge() attributes {pto.entry} {
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x96xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x160xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1 no_tmp {exhausted = false} : !pto.tile_buf<vec, 1x64xf32>, !pto.tile_buf<vec, 1x96xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x160xf32>, vector<4xi16>)
    return
  }
}
// CHECK: !pto.tile_buf<vec, 1x1280xf32>
// CHECK: pto.tmrgsort
// CPP: TMRGSORT<
