// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module {
  func.func @bad_layout(%ptr: !pto.ptr<f16>) {
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 128 : index
    %view = pto.make_tensor_view %ptr, shape = [%rows, %cols], strides = [%cols, %one] {layout = #pto.layout<dn>} : !pto.tensor_view<?x?xf16>
    return
  }
}
// CHECK: A1 vector DMA requires ND tensor views
