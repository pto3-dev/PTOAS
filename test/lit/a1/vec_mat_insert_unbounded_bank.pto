// RUN: not ptoas --pto-arch=a1 %s -o /dev/null 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @unknown_bank(%unknown: index) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %two = arith.constant 2 : index
    %stride = arith.constant 2048 : i64
    %base = arith.constant 0 : i64
    %remainder = arith.remui %unknown, %two : index
    %slot = arith.index_cast %remainder : index to i64
    %address = arith.muli %slot, %stride : i64
    %source = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 32x32xf16>
    %destination = pto.alloc_tile addr = %base : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>
    pto.tinsert ins(%source, %zero, %zero : !pto.tile_buf<vec, 32x32xf16>, index, index) outs(%destination : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>)
    return
  }
}
// CHECK: A1 tile address must be bounded, aligned, and within the 128 KiB UB budget
