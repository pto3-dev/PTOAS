// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @a1_single_fractal_gemm(%out: !pto.ptr<f32>, %lhs: !pto.ptr<f16>, %rhs: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %size = arith.constant 16 : index
    %lhs_view = pto.make_tensor_view %lhs, shape = [%size, %size], strides = [%size, %one] : !pto.tensor_view<?x?xf16>
    %rhs_view = pto.make_tensor_view %rhs, shape = [%size, %size], strides = [%size, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%size, %size], strides = [%size, %one] : !pto.tensor_view<?x?xf32>
    %lhs_part = pto.partition_view %lhs_view, offsets = [%zero, %zero], sizes = [%size, %size] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    %rhs_part = pto.partition_view %rhs_view, offsets = [%zero, %zero], sizes = [%size, %size] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%size, %size] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %ma = pto.alloc_tile : !pto.tile_buf<mat, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %mb = pto.alloc_tile : !pto.tile_buf<mat, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %a = pto.alloc_tile : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %b = pto.alloc_tile : !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %c = pto.alloc_tile : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %v = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%lhs_part : !pto.partition_tensor_view<16x16xf16>) outs(%ma : !pto.tile_buf<mat, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tload ins(%rhs_part : !pto.partition_tensor_view<16x16xf16>) outs(%mb : !pto.tile_buf<mat, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmov ins(%ma : !pto.tile_buf<mat, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%a : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmov ins(%mb : !pto.tile_buf<mat, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%b : !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmatmul ins(%a, %b : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>, !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%c : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmov ins(%c : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%v : !pto.tile_buf<vec, 16x16xf32>) {accToVecMode = #pto.acc_to_vec_mode<single_mode_vec0>}
    pto.tstore ins(%v : !pto.tile_buf<vec, 16x16xf32>) outs(%out_part : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}
// CHECK: A1 matrix tiles require
