// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @integer_add() {
    %a = pto.alloc_tile : !pto.tile_buf<vec, 8x8xi32>
    %b = pto.alloc_tile : !pto.tile_buf<vec, 8x8xi32>
    %c = pto.alloc_tile : !pto.tile_buf<vec, 8x8xi32>
    pto.tadd ins(%a, %b : !pto.tile_buf<vec, 8x8xi32>, !pto.tile_buf<vec, 8x8xi32>) outs(%c : !pto.tile_buf<vec, 8x8xi32>)
    return
  }
}
// CHECK: A1 integer Vec buffers support allocation, load/store and structural control flow only.
