// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s
// RUN: sed 's/i32/ui32/g' %s > %t.pto
// RUN: ptoas --pto-arch=a1 %t.pto -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_integer_reshape(%output: !pto.ptr<i32>, %input: !pto.ptr<i32>, %replacement: !pto.ptr<i32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 8 : index
    %cols = arith.constant 32 : index
    %count = arith.constant 256 : index
    %output_cols = arith.constant 512 : index
    %input_view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xi32>
    %replacement_view = pto.make_tensor_view %replacement, shape = [%one, %count], strides = [%count, %one] : !pto.tensor_view<?x?xi32>
    %output_view = pto.make_tensor_view %output, shape = [%one, %output_cols], strides = [%output_cols, %one] : !pto.tensor_view<?x?xi32>
    %input_part = pto.partition_view %input_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<8x32xi32>
    %replacement_part = pto.partition_view %replacement_view, offsets = [%zero, %zero], sizes = [%one, %count] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x256xi32>
    %first_part = pto.partition_view %output_view, offsets = [%zero, %zero], sizes = [%one, %count] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x256xi32>
    %second_part = pto.partition_view %output_view, offsets = [%zero, %count], sizes = [%one, %count] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x256xi32>
    %source = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi32>
    pto.tload ins(%input_part : !pto.partition_tensor_view<8x32xi32>) outs(%source : !pto.tile_buf<vec, 8x32xi32>)
    %flat = pto.treshape %source : !pto.tile_buf<vec, 8x32xi32> -> !pto.tile_buf<vec, 1x256xi32>
    %rows_view = pto.treshape %flat : !pto.tile_buf<vec, 1x256xi32> -> !pto.tile_buf<vec, 16x16xi32>
    %identity = pto.treshape %rows_view : !pto.tile_buf<vec, 16x16xi32> -> !pto.tile_buf<vec, 16x16xi32>
    %first = pto.treshape %identity : !pto.tile_buf<vec, 16x16xi32> -> !pto.tile_buf<vec, 1x256xi32>
    pto.tstore ins(%first : !pto.tile_buf<vec, 1x256xi32>) outs(%first_part : !pto.partition_tensor_view<1x256xi32>)
    pto.tload ins(%replacement_part : !pto.partition_tensor_view<1x256xi32>) outs(%flat : !pto.tile_buf<vec, 1x256xi32>)
    %restored = pto.treshape %source : !pto.tile_buf<vec, 8x32xi32> -> !pto.tile_buf<vec, 1x256xi32>
    pto.tstore ins(%restored : !pto.tile_buf<vec, 1x256xi32>) outs(%second_part : !pto.partition_tensor_view<1x256xi32>)
    return
  }
}
// CHECK-LABEL: a1_integer_reshape(
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: TRESHAPE(
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: TSTORE(
// CHECK: set_flag(PIPE_MTE3, PIPE_MTE2,
// CHECK: wait_flag(PIPE_MTE3, PIPE_MTE2,
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: TSTORE(
