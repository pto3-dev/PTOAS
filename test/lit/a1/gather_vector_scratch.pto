// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s --implicit-check-not='PIPE_S, PIPE_MTE3'
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s --implicit-check-not='PIPE_S, PIPE_MTE3'
// The result is not stored: only a vector scratch def can cause this store edge.
module attributes {pto.target_arch = "a1"} {
  func.func @a1_gather_scratch_store(%output: !pto.ptr<i32>, %input: !pto.ptr<f32>, %positions: !pto.ptr<i32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %source_cols = arith.constant 80 : index
    %cols = arith.constant 96 : index
    %scratch_cols = arith.constant 192 : index
    %input_view = pto.make_tensor_view %input, shape = [%one, %source_cols], strides = [%source_cols, %one] : !pto.tensor_view<?x?xf32>
    %index_view = pto.make_tensor_view %positions, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xi32>
    %output_view = pto.make_tensor_view %output, shape = [%one, %scratch_cols], strides = [%scratch_cols, %one] : !pto.tensor_view<?x?xi32>
    %input_part = pto.partition_view %input_view, offsets = [%zero, %zero], sizes = [%one, %source_cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x80xf32>
    %index_part = pto.partition_view %index_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x96xi32>
    %output_part = pto.partition_view %output_view, offsets = [%zero, %zero], sizes = [%one, %scratch_cols] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x192xi32>
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x80xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x96xi32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x192xi32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x96xf32>
    pto.tload ins(%input_part : !pto.partition_tensor_view<1x80xf32>) outs(%source : !pto.tile_buf<vec, 1x80xf32>)
    pto.tload ins(%index_part : !pto.partition_tensor_view<1x96xi32>) outs(%indices : !pto.tile_buf<vec, 1x96xi32>)
    // Preserve the initialized suffix not touched by vector offset generation.
    pto.tload ins(%output_part : !pto.partition_tensor_view<1x192xi32>) outs(%scratch : !pto.tile_buf<vec, 1x192xi32>)
    pto.tgather ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x80xf32>, !pto.tile_buf<vec, 1x96xi32>, !pto.tile_buf<vec, 1x192xi32>) outs(%result : !pto.tile_buf<vec, 1x96xf32>)
    pto.tstore ins(%scratch : !pto.tile_buf<vec, 1x192xi32>) outs(%output_part : !pto.partition_tensor_view<1x192xi32>)
    return
  }
}
// CHECK-LABEL: a1_gather_scratch_store(
// CHECK-COUNT-3: TLOAD(
// CHECK: TGATHER(
// CHECK: set_flag(PIPE_V, PIPE_MTE3,
// CHECK: wait_flag(PIPE_V, PIPE_MTE3,
// CHECK: TSTORE(
