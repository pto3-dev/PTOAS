// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module {
  func.func @partial() {
    %rows = arith.constant 15 : index
    %cols = arith.constant 128 : index
    %tile = pto.alloc_tile valid_row = %rows valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    return
  }
}
// CHECK: A1 vector lowering requires static full row-major tile shapes
