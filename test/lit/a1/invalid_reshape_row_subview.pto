// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 %t/bounds.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ROWS
// RUN: not ptoas --pto-arch=a1 %t/columns.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ROWS
// RUN: not ptoas --pto-arch=a1 %t/dynamic.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ROWS
// RUN: not ptoas --pto-arch=a1 %t/argument.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ROWS
// RUN: not ptoas --pto-arch=a1 %t/integer.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=INTEGER
// ROWS: A1 Vec subviews require a bounded full-width static row interval
// INTEGER: A1 integer Vec buffers support allocation, load/store and structural control flow only

//--- bounds.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %zero = arith.constant 0 : index
    %row = arith.constant 3 : index
    %root = pto.alloc_tile : !pto.tile_buf<vec, 8x16xf32>
    %view = pto.treshape %root : !pto.tile_buf<vec, 8x16xf32> -> !pto.tile_buf<vec, 4x32xf32>
    %bad = pto.subview %view[%row, %zero] sizes [2, 32] : !pto.tile_buf<vec, 4x32xf32> -> !pto.tile_buf<vec, 2x32xf32>
    return
  }
}

//--- columns.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %zero = arith.constant 0 : index
    %row = arith.constant 0 : index
    %root = pto.alloc_tile : !pto.tile_buf<vec, 8x16xf32>
    %view = pto.treshape %root : !pto.tile_buf<vec, 8x16xf32> -> !pto.tile_buf<vec, 4x32xf32>
    %bad = pto.subview %view[%row, %zero] sizes [2, 16] : !pto.tile_buf<vec, 4x32xf32> -> !pto.tile_buf<vec, 2x16xf32>
    return
  }
}

//--- dynamic.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%dynamic: index) {
    %zero = arith.constant 0 : index
    %root = pto.alloc_tile : !pto.tile_buf<vec, 8x16xf32>
    %view = pto.treshape %root : !pto.tile_buf<vec, 8x16xf32> -> !pto.tile_buf<vec, 4x32xf32>
    %bad = pto.subview %view[%dynamic, %zero] sizes [2, 32] : !pto.tile_buf<vec, 4x32xf32> -> !pto.tile_buf<vec, 2x32xf32>
    return
  }
}

//--- argument.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%root: !pto.tile_buf<vec, 8x16xf32>) {
    %zero = arith.constant 0 : index
    %row = arith.constant 0 : index
    %view = pto.treshape %root : !pto.tile_buf<vec, 8x16xf32> -> !pto.tile_buf<vec, 4x32xf32>
    %bad = pto.subview %view[%row, %zero] sizes [2, 32] : !pto.tile_buf<vec, 4x32xf32> -> !pto.tile_buf<vec, 2x32xf32>
    return
  }
}

//--- integer.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %zero = arith.constant 0 : index
    %row = arith.constant 0 : index
    %root = pto.alloc_tile : !pto.tile_buf<vec, 8x16xi32>
    %view = pto.treshape %root : !pto.tile_buf<vec, 8x16xi32> -> !pto.tile_buf<vec, 4x32xi32>
    %bad = pto.subview %view[%row, %zero] sizes [2, 32] : !pto.tile_buf<vec, 4x32xi32> -> !pto.tile_buf<vec, 2x32xi32>
    return
  }
}
