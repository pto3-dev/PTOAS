#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=80, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>

// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @a1_mat_convtile_alias(%out: !pto.ptr<f32>, %input: !pto.ptr<f16>, %weight: !pto.ptr<f16>) attributes {pto.entry} {
    %addr0 = arith.constant 0 : i64
    %addr2560 = arith.constant 2560 : i64
    %c0 = arith.constant 0 : index
    %c80 = arith.constant 80 : index
    %c2 = arith.constant 2 : index
    %c5 = arith.constant 5 : index
    %c512 = arith.constant 512 : i64
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c720 = arith.constant 720 : index
    %wv = pto.make_tensor_view %weight, shape = [%c720, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf16>
    %wp = pto.partition_view %wv, offsets = [%c0, %c0], sizes = [%c720, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<720x16xf16>
    %ov = pto.make_tensor_view %out, shape = [%c16, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    %op = pto.partition_view %ov, offsets = [%c0, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %input2d = pto.make_tensor_view %input, shape = [%c16, %c80], strides = [%c80, %c1] : !pto.tensor_view<?x?xf16>
    %mat = pto.alloc_tile addr = %addr0 : !pto.tile_buf<mat, 16x80xf16, blayout=col_major, slayout=row_major, fractal=512>
    %image = pto.alloc_tile addr = %addr0 {config = #image_config} : !pto.conv_tile_buf<mat, 1x5x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    %weights = pto.alloc_tile addr = %addr2560 : !pto.tile_buf<mat, 720x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile addr = %addr0 : !pto.tile_buf<left, 16x720xf16, blayout=row_major, slayout=row_major, fractal=512>
    %right = pto.alloc_tile addr = %addr0 : !pto.tile_buf<right, 720x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %acc = pto.alloc_tile addr = %addr0 : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %result = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    scf.for %part = %c0 to %c5 step %c1 {
      %channel = arith.muli %part, %c16 : index
      %bank = arith.remui %part, %c2 : index
      %bank_i64 = arith.index_cast %bank : index to i64
      %bank_address = arith.muli %bank_i64, %c512 : i64
      %ub = pto.alloc_tile addr = %bank_address : !pto.tile_buf<vec, 16x16xf16>
      %input_part = pto.partition_view %input2d, offsets = [%c0, %channel], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
      pto.tload ins(%input_part : !pto.partition_tensor_view<16x16xf16>) outs(%ub : !pto.tile_buf<vec, 16x16xf16>)
      pto.tinsert ins(%ub, %c0, %channel : !pto.tile_buf<vec, 16x16xf16>, index, index) outs(%mat : !pto.tile_buf<mat, 16x80xf16, blayout=col_major, slayout=row_major, fractal=512>)
    }
    pto.tload ins(%wp : !pto.partition_tensor_view<720x16xf16>) outs(%weights : !pto.tile_buf<mat, 720x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.timg2col %left, %image, pos_m = %c0, pos_k = %c0 {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x720xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x5x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    pto.tmov ins(%weights : !pto.tile_buf<mat, 720x16xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%right : !pto.tile_buf<right, 720x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 16x720xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 720x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmov ins(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%result : !pto.tile_buf<vec, 16x16xf32>) {accToVecMode = #pto.acc_to_vec_mode<single_mode_vec0>}
    pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf32>) outs(%op : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}

// CHECK-LABEL: a1_mat_convtile_alias(
// CHECK: for (
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: TINSERT(
// CHECK: set_flag(PIPE_MTE3, PIPE_MTE1,
// CHECK: wait_flag(PIPE_MTE3, PIPE_MTE1,
// CHECK: TIMG2COL<
