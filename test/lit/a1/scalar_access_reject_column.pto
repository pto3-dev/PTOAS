// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @reject() attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %a = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=1, v_row=16, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>
    %v = pto.tgetval ins(%a, %zero : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=1, v_row=16, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>, index) outs : f32
    return
  }
}
// CHECK: A1 scalar tile access requires a full row-major FP32 Vec tile.
