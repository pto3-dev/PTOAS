// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
// CHECK: TMATMUL(
// CHECK: TMATMUL_ACC(

module attributes {pto.target_arch = "a1"} {
  func.func @kernel(%arg0: !pto.ptr<f16>, %arg1: !pto.ptr<f16>, %arg2: !pto.ptr<f16>, %__pypto_spmd_block_idx: i32, %__pypto_spmd_block_num: i32) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
  %c0_i64 = arith.constant 0 : i64
  %c512_i64 = arith.constant 512 : i64
  %c1024_i64 = arith.constant 1024 : i64
  %c1536_i64 = arith.constant 1536 : i64
  %c400_index = arith.constant 400 : index
  %c32_index = arith.constant 32 : index
  %c1_index = arith.constant 1 : index
  %c25_index = arith.constant 25 : index
  %c16_index = arith.constant 16 : index
  %c0_index = arith.constant 0 : index
  %query__ssa_v0_view = pto.make_tensor_view %arg0, shape = [%c400_index, %c32_index], strides = [%c32_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
  %key__ssa_v0_view = pto.make_tensor_view %arg1, shape = [%c400_index, %c32_index], strides = [%c32_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
  %output__ssa_v0_view = pto.make_tensor_view %arg2, shape = [%c400_index, %c400_index], strides = [%c400_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf16>
  %0 = pto.get_block_idx
  %t__tmp_v0 = arith.index_cast %0 : i64 to index
  %1 = pto.get_block_num
  %t__tmp_v1 = arith.index_cast %1 : i64 to index
  scf.for %row__idx_v0 = %t__tmp_v0 to %c25_index step %t__tmp_v1 {
    %q0__ssa_v0 = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %2 = arith.muli %row__idx_v0, %c16_index : index
    %3 = arith.maxsi %2, %c0_index : index
    %query__ssa_v0_pview = pto.partition_view %query__ssa_v0_view, offsets = [%3, %c0_index], sizes = [%c16_index, %c16_index] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    pto.tload ins(%query__ssa_v0_pview : !pto.partition_tensor_view<16x16xf16>) outs(%q0__ssa_v0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    %q1__ssa_v0 = pto.alloc_tile addr = %c512_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %4 = arith.muli %row__idx_v0, %c16_index : index
    %5 = arith.maxsi %4, %c0_index : index
    %6 = pto.partition_view %query__ssa_v0_view, offsets = [%5, %c16_index], sizes = [%c16_index, %c16_index] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    pto.tload ins(%6 : !pto.partition_tensor_view<16x16xf16>) outs(%q1__ssa_v0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    scf.for %column__idx_v0 = %c0_index to %c25_index step %c1_index {
      %k0__ssa_v0 = pto.alloc_tile addr = %c1024_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>
      %7 = arith.muli %column__idx_v0, %c16_index : index
      %8 = arith.maxsi %7, %c0_index : index
      %key__ssa_v0_pview = pto.partition_view %key__ssa_v0_view, offsets = [%8, %c0_index], sizes = [%c16_index, %c16_index] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
      pto.tload ins(%key__ssa_v0_pview : !pto.partition_tensor_view<16x16xf16>) outs(%k0__ssa_v0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      %k1__ssa_v0 = pto.alloc_tile addr = %c1536_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>
      %9 = arith.muli %column__idx_v0, %c16_index : index
      %10 = arith.maxsi %9, %c0_index : index
      %11 = pto.partition_view %key__ssa_v0_view, offsets = [%10, %c16_index], sizes = [%c16_index, %c16_index] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
      pto.tload ins(%11 : !pto.partition_tensor_view<16x16xf16>) outs(%k1__ssa_v0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      %t__tmp_v2 = pto.alloc_tile addr = %c1024_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>
      %q0__ssa_v0_Left = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=row_major, fractal=512, pad=0>
      pto.tmov ins(%q0__ssa_v0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>) outs(%q0__ssa_v0_Left : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      %t__tmp_v2_Right = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>
      pto.tmov ins(%t__tmp_v2 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%t__tmp_v2_Right : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      %acc__ssa_v0 = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
      pto.tmatmul ins(%q0__ssa_v0_Left, %t__tmp_v2_Right : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%acc__ssa_v0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      %t__tmp_v3 = pto.alloc_tile addr = %c1536_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>
      %q1__ssa_v0_Left = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=row_major, fractal=512, pad=0>
      pto.tmov ins(%q1__ssa_v0 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>) outs(%q1__ssa_v0_Left : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      %t__tmp_v3_Right = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>
      pto.tmov ins(%t__tmp_v3 : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%t__tmp_v3_Right : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      pto.tmatmul.acc ins(%acc__ssa_v0, %q1__ssa_v0_Left, %t__tmp_v3_Right : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=1024, pad=0>, !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=row_major, fractal=512, pad=0>, !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>) outs(%acc__ssa_v0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      %values__ssa_v0 = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      pto.tmov ins(%acc__ssa_v0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=1024, pad=0>) outs(%values__ssa_v0 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {accToVecMode = #pto.acc_to_vec_mode<single_mode_vec0>}
      %t__tmp_v4 = pto.alloc_tile addr = %c0_i64 valid_row = %c16_index valid_col = %c16_index : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      pto.tcvt ins(%values__ssa_v0 {rmode = #pto<round_mode NONE>, satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%t__tmp_v4 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      %12 = arith.muli %row__idx_v0, %c16_index : index
      %13 = arith.maxsi %12, %c0_index : index
      %14 = arith.muli %column__idx_v0, %c16_index : index
      %15 = arith.maxsi %14, %c0_index : index
      %output__iter_v3_pview = pto.partition_view %output__ssa_v0_view, offsets = [%13, %15], sizes = [%c16_index, %c16_index] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
      pto.tstore ins(%t__tmp_v4 : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=16, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%output__iter_v3_pview : !pto.partition_tensor_view<16x16xf16>)
    }
  }
  return
  }
}
