// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %s -o - 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @invalid_acc_subview() {
    %c0 = arith.constant 0 : index
    %addr0 = arith.constant 0 : i64
    %acc = pto.alloc_tile addr = %addr0 : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %bad = pto.subview %acc[%c0, %c0] sizes [16, 16] : !pto.tile_buf<acc, 32x32xf32, blayout=col_major, slayout=row_major, fractal=1024> -> !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    return
  }
}
// CHECK: A1 accumulator subviews require one full-height aligned N16 column panel
