// RUN: ptoas --pto-arch=a1 --pto-level=level1 %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s

#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>

module attributes {pto.target_arch = "a1"} {
  func.func @a1_hardware_im2col_mat(%out: !pto.ptr<f32>, %input: !pto.ptr<f16>, %weight: !pto.ptr<f16>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %c63 = arith.constant 63 : index
    %c64 = arith.constant 64 : index
    %c256 = arith.constant 256 : index
    %c288 = arith.constant 288 : index
    %c2048 = arith.constant 2048 : index
    %invalid = arith.addi %c4, %c0 : index
    %c32 = arith.constant 32 : index
    %tv = pto.make_tensor_view %input, shape = [%c16, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf16>
    %image_part = pto.partition_view %tv, offsets = [%c0, %c0], sizes = [%c16, %c32] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x32xf16>
    %wv = pto.make_tensor_view %weight, shape = [%c288, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf16>
    %wp = pto.partition_view %wv, offsets = [%c0, %c0], sizes = [%c288, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<288x16xf16>
    %ov = pto.make_tensor_view %out, shape = [%c16, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    %op = pto.partition_view %ov, offsets = [%c0, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %image = pto.alloc_tile : !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    %weights = pto.alloc_tile : !pto.tile_buf<mat, 288x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>
    %right = pto.alloc_tile : !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %acc = pto.alloc_tile : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%image_part : !pto.partition_tensor_view<16x32xf16>) outs(%image : !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.tload ins(%wp : !pto.partition_tensor_view<288x16xf16>) outs(%weights : !pto.tile_buf<mat, 288x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.timg2col %left, %image, pos_m = %c0, pos_k = %c0 {fmatrixMode = #pto.fmatrix_mode<a_auto>, config = #image_config} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    pto.tmov ins(%weights : !pto.tile_buf<mat, 288x16xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%right : !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmov ins(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%result : !pto.tile_buf<vec, 16x16xf32>) {accToVecMode = #pto.acc_to_vec_mode<single_mode_vec0>}
    pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf32>) outs(%op : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}

// CHECK: static AICORE inline void PTOAS__INIT_CONVTILE_CONFIG(
// CHECK: a1_hardware_im2col_mat(
// CHECK: TLOAD(
// CHECK-DAG: PTOAS__INIT_CONVTILE_CONFIG(
// CHECK-DAG: .data()
// CHECK-DAG: set_flag(PIPE_MTE2, PIPE_MTE1,
// CHECK: TIMG2COL<
// CHECK: TMATMUL(
// CHECK: TSTORE(
