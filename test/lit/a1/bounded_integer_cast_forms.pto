// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s
// Keep all admitted cast forms in the normal lit suite, independent of CCEC.
module attributes {pto.target_arch = "a1"} {
  func.func @extended32(%input: !pto.ptr<f32>, %output: !pto.ptr<f32>, %raw: i32) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 336 : index
    %cols = arith.constant 96 : index
    %wide = arith.extui %raw : i32 to i64
    %index = arith.index_cast %wide : i64 to index
    %offset = arith.remsi %index, %rows : index
    %iv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ov = pto.make_tensor_view %output, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ip = pto.partition_view %iv, offsets = [%offset, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x96xf32>
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x96xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x96xf32>
    pto.tload ins(%ip : !pto.partition_tensor_view<1x96xf32>) outs(%tile : !pto.tile_buf<vec, 1x96xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 1x96xf32>) outs(%op : !pto.partition_tensor_view<1x96xf32>)
    return
  }
  func.func @direct8(%input: !pto.ptr<f32>, %output: !pto.ptr<f32>, %raw: i32) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 256 : index
    %cols = arith.constant 8 : index
    %narrow = arith.trunci %raw : i32 to i8
    %offset = arith.index_castui %narrow : i8 to index
    %iv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ov = pto.make_tensor_view %output, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ip = pto.partition_view %iv, offsets = [%offset, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.tload ins(%ip : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%op : !pto.partition_tensor_view<1x8xf32>)
    return
  }
  func.func @direct16(%input: !pto.ptr<f32>, %output: !pto.ptr<f32>, %raw: i32) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 65536 : index
    %cols = arith.constant 8 : index
    %narrow = arith.trunci %raw : i32 to i16
    %offset = arith.index_castui %narrow : i16 to index
    %iv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ov = pto.make_tensor_view %output, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ip = pto.partition_view %iv, offsets = [%offset, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.tload ins(%ip : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%op : !pto.partition_tensor_view<1x8xf32>)
    return
  }
}
// CHECK-LABEL: extended32(
// CHECK: TLOAD(
// CHECK: TSTORE(
// CHECK-LABEL: direct8(
// CHECK: TLOAD(
// CHECK: TSTORE(
// CHECK-LABEL: direct16(
// CHECK: TLOAD(
// CHECK: TSTORE(
