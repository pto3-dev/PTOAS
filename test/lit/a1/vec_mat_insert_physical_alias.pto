// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_vec_mat_insert(%in: !pto.ptr<f16>, %initial: !pto.ptr<f16>) attributes {pto.entry} {
    %addr0 = arith.constant 0 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %off = arith.constant 16 : index
    %n32 = arith.constant 32 : index
    %n64 = arith.constant 64 : index
    %iv = pto.make_tensor_view %in, shape = [%n32, %n32], strides = [%n32, %one] : !pto.tensor_view<?x?xf16>
    %mv = pto.make_tensor_view %initial, shape = [%n64, %n64], strides = [%n64, %one] : !pto.tensor_view<?x?xf16>
    %ip = pto.partition_view %iv, offsets = [%zero, %zero], sizes = [%n32, %n32] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<32x32xf16>
    %mp = pto.partition_view %mv, offsets = [%zero, %zero], sizes = [%n64, %n64] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x64xf16>
    %src = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 32x32xf16>
    %src2 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 32x32xf16>
    %mat = pto.alloc_tile addr = %addr0 : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>
    %mat2 = pto.alloc_tile addr = %addr0 : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile addr = %addr0 : !pto.tile_buf<left, 64x64xf16, blayout=row_major, slayout=row_major, fractal=512>
    pto.tload ins(%ip : !pto.partition_tensor_view<32x32xf16>) outs(%src : !pto.tile_buf<vec, 32x32xf16>)
    pto.tload ins(%mp : !pto.partition_tensor_view<64x64xf16>) outs(%mat : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.tinsert ins(%src, %off, %off : !pto.tile_buf<vec, 32x32xf16>, index, index) outs(%mat : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.tload ins(%ip : !pto.partition_tensor_view<32x32xf16>) outs(%src2 : !pto.tile_buf<vec, 32x32xf16>)
    pto.tinsert ins(%src2, %zero, %zero : !pto.tile_buf<vec, 32x32xf16>, index, index) outs(%mat : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.tmov ins(%mat2 : !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%left : !pto.tile_buf<left, 64x64xf16, blayout=row_major, slayout=row_major, fractal=512>)
    return
  }
}
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: TINSERT(
// CHECK: set_flag(PIPE_MTE3, PIPE_MTE2,
// CHECK: TLOAD(
// CHECK: TINSERT(
// CHECK: set_flag(PIPE_MTE3, PIPE_MTE1,
// CHECK: TMOV(
