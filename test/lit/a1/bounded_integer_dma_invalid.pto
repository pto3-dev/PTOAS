//--- unaligned.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%input: !pto.ptr<f32>, %raw: i32, %wide: i64, %unknown: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 336 : index
    %cols = arith.constant 96 : index
    %width = arith.constant 8 : index
    %index = arith.index_castui %raw : i32 to index
    %nine = arith.constant 9 : index
    %offset = arith.remsi %index, %nine : index
    %view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view, offsets = [%zero, %offset], sizes = [%one, %width] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.tload ins(%part : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

//--- first_invalid_u8.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%input: !pto.ptr<f32>, %raw: i32, %wide: i64, %unknown: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 255 : index
    %cols = arith.constant 8 : index
    %width = arith.constant 8 : index
    %narrow = arith.trunci %raw : i32 to i8
    %offset = arith.index_castui %narrow : i8 to index
    %view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %width] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.tload ins(%part : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

//--- narrow_destination.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%input: !pto.ptr<f32>, %raw: i32, %wide: i64, %unknown: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 256 : index
    %cols = arith.constant 8 : index
    %width = arith.constant 8 : index
    %narrow = arith.trunci %raw : i32 to i8
    %extended = arith.extui %narrow : i8 to i32
    %offset = arith.index_cast %extended : i32 to index
    %view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %width] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.tload ins(%part : !pto.partition_tensor_view<1x8xf32>) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}
