// CASE17: A1 sort32 requires disjoint writable buffers.
//--- shifted_alias.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_addr = arith.constant 0 : i64
    %indices_addr = arith.constant 4096 : i64
    %scratch_addr = arith.constant 16384 : i64
    %result_addr = arith.constant 32 : i64
    %source = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile addr = %result_addr : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}
