  }
}

// CASE5: A1 sort32 requires 32-aligned values
//--- idx_rows.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 3x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 2x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 3x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 3x32xf32>, !pto.tile_buf<vec, 2x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 3x64xf32>)
    return
  }
