// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 %t/value_dtype.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE0
// RUN: not ptoas --pto-arch=a1 %t/signed_index.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE1
// RUN: not ptoas --pto-arch=a1 %t/block_tail.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE2
// RUN: not ptoas --pto-arch=a1 %t/dst_width.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE3
// RUN: not ptoas --pto-arch=a1 %t/idx_width.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE4
// RUN: not ptoas --pto-arch=a1 %t/idx_rows.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE5
// RUN: not ptoas --pto-arch=a1 %t/scratch_dtype.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE6
// RUN: not ptoas --pto-arch=a1 %t/scratch_capacity.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE7
// RUN: not ptoas --pto-arch=a1 %t/column_major.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE8
// RUN: not ptoas --pto-arch=a1 %t/partial.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE9
// RUN: not ptoas --pto-arch=a1 %t/budget.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE10
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/level3_implicit.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE11
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/alias_0.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE12
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/alias_1.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE13
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/alias_2.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE14
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/alias_3.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE15
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/alias_4.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE16

// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/shifted_alias.pto -o - 2>&1 | FileCheck %s --check-prefix=CASE17

// CASE0: A1 sort32 requires FP32 source/destination and UINT32 indices
//--- value_dtype.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf16>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf16>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf16>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf16>)
    return
  }
}

// CASE1: A1 sort32 requires FP32 source/destination and UINT32 indices
//--- signed_index.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xi32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xi32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

// CASE2: A1 sort32 requires 32-aligned values
//--- block_tail.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x40xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x40xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x80xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x40xf32>, !pto.tile_buf<vec, 1x40xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x80xf32>)
    return
  }
}

// CASE3: A1 sort32 requires 32-aligned values
//--- dst_width.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x72xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x72xf32>)
    return
  }
}

// CASE4: A1 sort32 requires 32-aligned values
//--- idx_width.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x64xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
