    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x64xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
