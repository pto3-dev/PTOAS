// CASE6: A1 tsort32 tmp requires FP32 elements
//--- scratch_dtype.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x1024xf16>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x1024xf16>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

// CASE7: expects tmp capacity to be at least 2048 bytes
//--- scratch_capacity.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x504xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x504xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

// CASE8: expects src to use the row_major blayout
//--- column_major.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 8x32xf32, blayout=col_major>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 8x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 8x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 8x32xf32, blayout=col_major>, !pto.tile_buf<vec, 8x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 8x64xf32>)
    return
  }
}

// CASE9: A1 vector lowering requires static full row-major
//--- partial.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=24, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x512xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=24, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

// CASE10: 128 KiB UB budget
//--- budget.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x32776xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x32776xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

// CASE11: A1 tsort32 requires explicit tmp when PlanMemory is skipped
//--- level3_implicit.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_addr = arith.constant 0 : i64
    %source = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %indices_addr = arith.constant 4096 : i64
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 1x32xui32>
    %result_addr = arith.constant 8192 : i64
    %result = pto.alloc_tile addr = %result_addr : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

// CASE12: A1 sort32 requires disjoint writable buffers
//--- alias_0.pto
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_addr = arith.constant 0 : i64
    %source = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %indices_addr = arith.constant 4096 : i64
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 1x32xui32>
    %scratch_addr = arith.constant 16384 : i64
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x512xf32>
    %result_addr = arith.constant 0 : i64
    %result = pto.alloc_tile addr = %result_addr : !pto.tile_buf<vec, 1x64xf32>
    pto.tsort32 ins(%source, %indices, %scratch : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xui32>, !pto.tile_buf<vec, 1x512xf32>) outs(%result : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

