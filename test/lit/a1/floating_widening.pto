// RUN: ptoas --pto-arch=a1 --plan-memory-impl=modern %s -o - | FileCheck %s
// RUN: ptoas --plan-memory-impl=legacy %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_conversion(%out: !pto.ptr<f32>, %input: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %cols = arith.constant 16 : index
    %input_view = pto.make_tensor_view %input, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %input_part = pto.partition_view %input_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x16xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x16xf32>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf32>
    pto.tload ins(%input_part : !pto.partition_tensor_view<1x16xf16>) outs(%src : !pto.tile_buf<vec, 1x16xf16>)
    pto.tcvt ins(%src {rmode = #pto<round_mode NONE>, satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x16xf16>) outs(%dst : !pto.tile_buf<vec, 1x16xf32>)
    pto.tstore ins(%dst : !pto.tile_buf<vec, 1x16xf32>) outs(%out_part : !pto.partition_tensor_view<1x16xf32>)
    return
  }
}
// CHECK: a1_conversion(
// CHECK: set_flag(PIPE_MTE2, PIPE_V,
// CHECK: RoundMode [[ROUND:[A-Za-z0-9_]+]] = RoundMode::CAST_NONE
// CHECK: SaturationMode [[SAT:[A-Za-z0-9_]+]] = SaturationMode::OFF
// CHECK: TCVT({{.*}}[[ROUND]], [[SAT]])
// CHECK: set_flag(PIPE_V, PIPE_MTE3,
// CHECK: TSTORE(
