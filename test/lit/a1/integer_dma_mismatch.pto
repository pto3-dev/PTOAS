// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @integer_mismatched_load(%out: !pto.ptr<i32>, %lhs: !pto.ptr<i32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 8 : index
    %cols = arith.constant 8 : index
    %lhs_view = pto.make_tensor_view %lhs, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xi32>
    %out_view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xi32>
    %lhs_part = pto.partition_view %lhs_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<8x8xi32>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<8x8xi32>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 8x8xui32>
    pto.tload ins(%lhs_part : !pto.partition_tensor_view<8x8xi32>) outs(%a : !pto.tile_buf<vec, 8x8xui32>)
    pto.tstore ins(%a : !pto.tile_buf<vec, 8x8xui32>) outs(%out_part : !pto.partition_tensor_view<8x8xi32>)
    return
  }
}
// CHECK: A1 DMA requires matching tensor and tile element types.
