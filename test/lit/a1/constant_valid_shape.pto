// RUN: ptoas --pto-arch=a1 --enable-insert-sync %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --emit-pto-ir %s -o - | FileCheck %s --check-prefix=IR

module attributes {pto.target_arch = "a1"} {
  func.func @a1_vector_add(%out: !pto.ptr<f16>, %lhs: !pto.ptr<f16>, %rhs: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 128 : index
    %lhs_view = pto.make_tensor_view %lhs, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %rhs_view = pto.make_tensor_view %rhs, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %lhs_part = pto.partition_view %lhs_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x128xf16>
    %rhs_part = pto.partition_view %rhs_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x128xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x128xf16>
    %a = pto.alloc_tile valid_row = %rows valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %b = pto.alloc_tile valid_row = %rows valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %c = pto.alloc_tile valid_row = %rows valid_col = %cols : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%lhs_part : !pto.partition_tensor_view<16x128xf16>) outs(%a : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%rhs_part : !pto.partition_tensor_view<16x128xf16>) outs(%b : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tadd ins(%a, %b : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%c : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tstore ins(%c : !pto.tile_buf<loc=vec, dtype=f16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%out_part : !pto.partition_tensor_view<16x128xf16>)
    return
  }
}

// CHECK: Tile<TileType::Vec, half, 16, 128, BLayout::RowMajor, 16, 128,
// CHECK: TADD(
// CHECK: TSTORE(
// IR: pto.alloc_tile
// IR-SAME: !pto.tile_buf<vec, 16x128xf16>
// IR-NOT: v_row=?
