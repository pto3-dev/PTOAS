// RUN: ptoas --pto-arch=a1 --plan-memory-impl=modern %s -o - | FileCheck %s
// RUN: ptoas --plan-memory-impl=legacy %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_rowmax(%input: !pto.ptr<f32>, %output: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 80 : index
    %iv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %ov = pto.make_tensor_view %output, shape = [%rows, %one], strides = [%one, %one] : !pto.tensor_view<?x?xf32>
    %ip = pto.partition_view %iv, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x80xf32>
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%rows, %one] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x1xf32>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x80xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=1, v_row=16, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 16x80xf32>
    pto.tload ins(%ip : !pto.partition_tensor_view<16x80xf32>) outs(%src : !pto.tile_buf<vec, 16x80xf32>)
    pto.trowmax ins(%src, %tmp : !pto.tile_buf<vec, 16x80xf32>, !pto.tile_buf<vec, 16x80xf32>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=1, v_row=16, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>)
    pto.tstore ins(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=1, v_row=16, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>) outs(%op : !pto.partition_tensor_view<16x1xf32>)
    return
  }
}
// CHECK: a1_rowmax(
// CHECK: TLOAD(
// CHECK: TROWMAX(
// CHECK: TSTORE(
