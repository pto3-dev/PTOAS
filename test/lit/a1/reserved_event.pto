// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module {
  func.func @bad_event() {
    pto.set_flag [#pto.pipe<PIPE_MTE2>, #pto.pipe<PIPE_V>, #pto.event<EVENT_ID7>]
    return
  }
}
// CHECK: A1 event ID 7 is reserved for ISA helpers
