// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s

#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>

module attributes {pto.target_arch = "a1"} {
  func.func @a1_hardware_im2col_double_buffer(%out: !pto.ptr<f32>, %input: !pto.ptr<f16>, %weight: !pto.ptr<f16>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %addr0 = arith.constant 0 : i64
    %addr1 = arith.constant 9216 : i64
    %addr1024 = arith.constant 1024 : i64
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %c63 = arith.constant 63 : index
    %c64 = arith.constant 64 : index
    %c256 = arith.constant 256 : index
    %c288 = arith.constant 288 : index
    %c2048 = arith.constant 2048 : index
    %tv = pto.make_tensor_view %input, shape = [%c1, %c4, %c8, %c4, %c16], strides = [%c2048, %c16, %c256, %c64, %c1] : !pto.tensor_view<1x4x8x4x16xf16, #pto.conv_layout<nc1hwc0>>
    %image_part = pto.partition_view %tv, offsets = [%c0, %c1, %c2, %c0, %c0], sizes = [%c1, %c2, %c4, %c4, %c16] : !pto.tensor_view<1x4x8x4x16xf16, #pto.conv_layout<nc1hwc0>> -> !pto.partition_tensor_view<1x2x4x4x16xf16, #pto.conv_layout<nc1hwc0>>
    %wv = pto.make_tensor_view %weight, shape = [%c288, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf16>
    %wp = pto.partition_view %wv, offsets = [%c0, %c0], sizes = [%c288, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<288x16xf16>
    %ov = pto.make_tensor_view %out, shape = [%c16, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    %op = pto.partition_view %ov, offsets = [%c0, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    %image = pto.alloc_tile addr = %addr0 {config = #image_config} : !pto.conv_tile_buf<mat, 1x2x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    %weights = pto.alloc_tile addr = %addr1024 : !pto.tile_buf<mat, 288x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile addr = %addr0 : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>
    %left_second = pto.alloc_tile addr = %addr1 : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>
    %right = pto.alloc_tile addr = %addr0 : !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %acc = pto.alloc_tile addr = %addr0 : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %result = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 16x16xf32>
    pto.tload ins(%image_part : !pto.partition_tensor_view<1x2x4x4x16xf16, #pto.conv_layout<nc1hwc0>>) outs(%image : !pto.conv_tile_buf<mat, 1x2x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>)
    pto.tload ins(%wp : !pto.partition_tensor_view<288x16xf16>) outs(%weights : !pto.tile_buf<mat, 288x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.timg2col %left, %image, pos_m = %c0, pos_k = %c0 {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x2x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    pto.tmov ins(%weights : !pto.tile_buf<mat, 288x16xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%right : !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.timg2col %left_second, %image, pos_m = %c0, pos_k = %c0 {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x2x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    pto.tmatmul.acc ins(%acc, %left_second, %right : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 288x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmov ins(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%result : !pto.tile_buf<vec, 16x16xf32>) {accToVecMode = #pto.acc_to_vec_mode<single_mode_vec0>}
    pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf32>) outs(%op : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}

// CHECK: a1_hardware_im2col_double_buffer(
// CHECK: TLOAD(
// CHECK: TIMG2COL<
// CHECK: TMATMUL(
// CHECK-NOT: wait_flag(PIPE_M, PIPE_MTE1,
// CHECK: TIMG2COL<
// CHECK: TMATMUL_ACC(
// CHECK: TSTORE(
