// RUN: not ptoas --pto-arch=a1 %s -o /dev/null 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @mat_column_dynamic(%column: index) attributes {pto.entry} {
    %row = arith.constant 0 : index
    %source = pto.alloc_tile : !pto.tile_buf<mat, 64x96xf16, blayout=col_major, slayout=row_major, fractal=512>
    %view = pto.subview %source[%row, %column] sizes [64, 32] : !pto.tile_buf<mat, 64x96xf16, blayout=col_major, slayout=row_major, fractal=512> -> !pto.tile_buf<mat, 64x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    %right = pto.alloc_tile : !pto.tile_buf<right, 64x32xf16, blayout=row_major, slayout=col_major, fractal=512>
    pto.tmov ins(%view : !pto.tile_buf<mat, 64x32xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%right : !pto.tile_buf<right, 64x32xf16, blayout=row_major, slayout=col_major, fractal=512>)
    return
  }
}
// CHECK: A1 Mat subviews require
