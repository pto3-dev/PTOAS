// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @a1_f32_muls(%out: !pto.ptr<f32>, %input: !pto.ptr<f32>, %factor: f32) attributes {pto.entry} {
    %zero64 = arith.constant 0 : i64
    %address = arith.constant 32 : i64
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 8 : index
    %cols = arith.constant 8 : index
    %input_view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %output_view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %input_part = pto.partition_view %input_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<8x8xf32>
    %output_part = pto.partition_view %output_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<8x8xf32>
    %a = pto.alloc_tile addr = %zero64 : !pto.tile_buf<vec, 8x8xf32>
    %b = pto.alloc_tile addr = %address : !pto.tile_buf<vec, 8x8xf32>
    pto.tload ins(%input_part : !pto.partition_tensor_view<8x8xf32>) outs(%a : !pto.tile_buf<vec, 8x8xf32>)
    pto.tmuls ins(%a, %factor : !pto.tile_buf<vec, 8x8xf32>, f32) outs(%b : !pto.tile_buf<vec, 8x8xf32>)
    pto.tstore ins(%b : !pto.tile_buf<vec, 8x8xf32>) outs(%output_part : !pto.partition_tensor_view<8x8xf32>)
    return
  }
}

// CHECK: A1 scalar multiply requires disjoint storage or an exact alias.
