// RUN: ptoas --pto-arch=a1 --pto-level=level1 %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s

#image_config = #pto.conv_tile_config<fmap_h=8, fmap_w=8, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=16, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>

module attributes {pto.target_arch = "a1"} {
  func.func @subtraction_dma(%out: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %sixteen = arith.constant 16 : index
    %rows = arith.constant 32 : index
    %value = arith.constant 1.0 : f32
    %view = pto.make_tensor_view %out, shape = [%rows, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xf32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x8xf32>
    pto.texpands ins(%value : f32) outs(%tile : !pto.tile_buf<vec, 1x8xf32>)
    %block64 = pto.get_block_idx
    %blocks64 = pto.get_block_num
    %block = arith.index_cast %block64 : i64 to index
    %blocks = arith.index_cast %blocks64 : i64 to index
    scf.for %i = %block to %rows step %blocks {
      %shifted = arith.addi %i, %sixteen : index
      %offset = arith.subi %shifted, %sixteen : index
      %part = pto.partition_view %view, offsets = [%offset, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x8xf32>) outs(%part : !pto.partition_tensor_view<1x8xf32>)
    }
    return
  }

  func.func @subtraction_im2col(%input: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %three = arith.constant 3 : index
    %sixteen = arith.constant 16 : index
    %rows = arith.constant 64 : index
    %view = pto.make_tensor_view %input, shape = [%rows, %sixteen], strides = [%sixteen, %one] : !pto.tensor_view<?x?xf16>
    %part = pto.partition_view %view, offsets = [%zero, %zero], sizes = [%rows, %sixteen] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x16xf16>
    %image = pto.alloc_tile : !pto.tile_buf<mat, 64x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %left = pto.alloc_tile : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=row_major, fractal=512>
    pto.tload ins(%part : !pto.partition_tensor_view<64x16xf16>) outs(%image : !pto.tile_buf<mat, 64x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    scf.for %i = %zero to %three step %one {
      %next = arith.addi %i, %one : index
      %scaled = arith.muli %next, %sixteen : index
      %offset = arith.subi %scaled, %sixteen : index
      pto.timg2col %left, %image, pos_m = %offset, pos_k = %offset {fmatrixMode = #pto.fmatrix_mode<a_auto>, config = #image_config} : !pto.tile_buf<left, 16x16xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 64x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    }
    return
  }
}

// CHECK-LABEL: subtraction_dma(
// CHECK: get_block_idx()
// CHECK: get_block_num()
// CHECK: TSTORE(
// CHECK-LABEL: subtraction_im2col(
// CHECK: TIMG2COL<
