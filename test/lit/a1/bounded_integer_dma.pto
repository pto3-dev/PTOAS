// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s
// Zero extension proves the signless raw word nonnegative before signed modulo.
module attributes {pto.target_arch = "a1"} {
  func.func @a1_bounded_integer_dma(%input: !pto.ptr<f32>, %words: !pto.ptr<i32>, %out: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %rows = arith.constant 336 : index
    %cols = arith.constant 96 : index
    %iv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %wv = pto.make_tensor_view %words, shape = [%one, %eight], strides = [%eight, %one] : !pto.tensor_view<?x?xi32>
    %ov = pto.make_tensor_view %out, shape = [%eight, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %wp = pto.partition_view %wv, offsets = [%zero, %zero], sizes = [%one, %eight] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x8xi32>
    %wt = pto.alloc_tile : !pto.tile_buf<vec, 1x8xi32>
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 1x96xf32>
    pto.tload ins(%wp : !pto.partition_tensor_view<1x8xi32>) outs(%wt : !pto.tile_buf<vec, 1x8xi32>)
    scf.for %choice = %zero to %eight step %one {
      %word = pto.tgetval ins(%wt, %choice : !pto.tile_buf<vec, 1x8xi32>, index) outs : i32
      %index = arith.index_castui %word : i32 to index
      %selected_row = arith.remsi %index, %rows : index
      %ip = pto.partition_view %iv, offsets = [%selected_row, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x96xf32>
      %op = pto.partition_view %ov, offsets = [%choice, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x96xf32>
      pto.tload ins(%ip : !pto.partition_tensor_view<1x96xf32>) outs(%tile : !pto.tile_buf<vec, 1x96xf32>)
      pto.tstore ins(%tile : !pto.tile_buf<vec, 1x96xf32>) outs(%op : !pto.partition_tensor_view<1x96xf32>)
    }
    return
  }
}
// CHECK-LABEL: a1_bounded_integer_dma(
// CHECK: TLOAD(
// CHECK: .GetValue(
// CHECK: TLOAD(
// CHECK: TSTORE(
