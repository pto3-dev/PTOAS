// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: not ptoas --pto-arch=a3 %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=A3
module attributes {pto.target_arch = "a1"} {
  func.func @a1_left_panel_insert(%out: !pto.ptr<f32>, %lhs: !pto.ptr<f16>, %rhs: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %four = arith.constant 4 : index
    %c16 = arith.constant 16 : index
    %rows = arith.constant 32 : index
    %k = arith.constant 64 : index
    %lhs_view = pto.make_tensor_view %lhs, shape = [%rows, %c16], strides = [%c16, %one] : !pto.tensor_view<?x?xf16>
    %rhs_view = pto.make_tensor_view %rhs, shape = [%k, %c16], strides = [%c16, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%rows, %c16], strides = [%c16, %one] : !pto.tensor_view<?x?xf32>
    %lhs_part = pto.partition_view %lhs_view, offsets = [%zero, %zero], sizes = [%rows, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<32x16xf16>
    %rhs_part = pto.partition_view %rhs_view, offsets = [%zero, %zero], sizes = [%k, %c16] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x16xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%rows, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<32x16xf32>
    %ma = pto.alloc_tile : !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %mb = pto.alloc_tile : !pto.tile_buf<mat, 64x16xf16, blayout=col_major, slayout=row_major, fractal=512>
    %a = pto.alloc_tile : !pto.tile_buf<left, 32x64xf16, blayout=row_major, slayout=row_major, fractal=512>
    %b = pto.alloc_tile : !pto.tile_buf<right, 64x16xf16, blayout=row_major, slayout=col_major, fractal=512>
    %c = pto.alloc_tile : !pto.tile_buf<acc, 32x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %v = pto.alloc_tile : !pto.tile_buf<vec, 32x16xf32>
    pto.tload ins(%lhs_part : !pto.partition_tensor_view<32x16xf16>) outs(%ma : !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    pto.tload ins(%rhs_part : !pto.partition_tensor_view<64x16xf16>) outs(%mb : !pto.tile_buf<mat, 64x16xf16, blayout=col_major, slayout=row_major, fractal=512>)
    scf.for %i = %zero to %four step %one {
      %column = arith.muli %i, %c16 : index
      pto.tinsert ins(%ma, %zero, %column : !pto.tile_buf<mat, 32x16xf16, blayout=col_major, slayout=row_major, fractal=512>, index, index) outs(%a : !pto.tile_buf<left, 32x64xf16, blayout=row_major, slayout=row_major, fractal=512>)
    }
    pto.tmov ins(%mb : !pto.tile_buf<mat, 64x16xf16, blayout=col_major, slayout=row_major, fractal=512>) outs(%b : !pto.tile_buf<right, 64x16xf16, blayout=row_major, slayout=col_major, fractal=512>)
    pto.tmatmul ins(%a, %b : !pto.tile_buf<left, 32x64xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 64x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%c : !pto.tile_buf<acc, 32x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmatmul.acc ins(%c, %a, %b : !pto.tile_buf<acc, 32x16xf32, blayout=col_major, slayout=row_major, fractal=1024>, !pto.tile_buf<left, 32x64xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 64x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%c : !pto.tile_buf<acc, 32x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
    pto.tmov ins(%c : !pto.tile_buf<acc, 32x16xf32, blayout=col_major, slayout=row_major, fractal=1024>) outs(%v : !pto.tile_buf<vec, 32x16xf32>) {accToVecMode = #pto.acc_to_vec_mode<single_mode_vec0>}
    pto.tstore ins(%v : !pto.tile_buf<vec, 32x16xf32>) outs(%out_part : !pto.partition_tensor_view<32x16xf32>)
    return
  }
}
// CHECK-NOT: PIPE_FIX
// CHECK: a1_left_panel_insert(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE1,
// CHECK: TINSERT(
// CHECK: set_flag(PIPE_MTE1, PIPE_M,
// CHECK: TMATMUL(
// CHECK: TMATMUL_ACC(
// CHECK-NOT: PIPE_FIX
// A3: expects A2/A3 tinsert to use acc->mat or vec->vec
