// RUN: not ptoas --pto-arch=a1 %s -o - 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @used_flat(%input: !pto.ptr<f32>) {
    %one = arith.constant 1 : index
    %size = arith.constant 256 : index
    %zero = arith.constant 0 : index
    %view = pto.make_tensor_view %input, shape = [%size], strides = [%one] : !pto.tensor_view<?xf32>
    %part = pto.partition_view %view, offsets = [%zero], sizes = [%size] : !pto.tensor_view<?xf32> -> !pto.partition_tensor_view<256xf32>
    return
  }
}
// CHECK: A1 vector lowering requires two-dimensional tensor views.
