// RUN: ptoas --pto-arch=a1 --plan-memory-impl=modern %s -o - | FileCheck %s
// RUN: ptoas --plan-memory-impl=legacy %s -o - | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @a1_fp32_scalar(%out: !pto.ptr<f32>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 8 : index
    %cols = arith.constant 8 : index
    %out_view = pto.make_tensor_view %out, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf32>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<8x8xf32>
    %c = pto.alloc_tile : !pto.tile_buf<vec, 8x8xf32>
    %value = arith.constant -2.5 : f32
    pto.texpands ins(%value : f32) outs(%c : !pto.tile_buf<vec, 8x8xf32>)
    pto.tstore ins(%c : !pto.tile_buf<vec, 8x8xf32>) outs(%out_part : !pto.partition_tensor_view<8x8xf32>)
    return
  }
}

// CHECK: a1_fp32_scalar(
// CHECK: Tile<TileType::Vec, float, 8, 8,
// CHECK: TEXPANDS(
// CHECK: set_flag(PIPE_V, PIPE_MTE3,
// CHECK: TSTORE(
