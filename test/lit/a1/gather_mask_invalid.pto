// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/exact.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ALIAS
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/partial.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ALIAS
// RUN: not ptoas --pto-arch=a1 %t/width.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=WIDTH
// RUN: not ptoas --pto-arch=a1 %t/integer16.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=INTEGER
// RUN: not ptoas --pto-arch=a1 %t/partial_valid.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=FULL
// ALIAS: A1 mask gather requires disjoint writable buffers
// WIDTH: expects src and dst element sizes to match
// INTEGER: A1 vector lowering requires FP16, FP32 or 32-bit integer Vec tiles
// FULL: A1 vector lowering requires static full row-major tile shapes

//--- exact.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %zero = arith.constant 0 : i64
    %offset = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 1x64xf32>
    %dst = pto.alloc_tile addr = %offset : !pto.tile_buf<vec, 1x64xf32>
    pto.tgather ins(%src, {maskPattern = #pto.mask_pattern<P1111>} : !pto.tile_buf<vec, 1x64xf32>, "row") outs(%dst : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

//--- partial.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %zero = arith.constant 0 : i64
    %offset = arith.constant 32 : i64
    %src = pto.alloc_tile addr = %zero : !pto.tile_buf<vec, 1x128xf32>
    %dst = pto.alloc_tile addr = %offset : !pto.tile_buf<vec, 1x64xui32>
    pto.tgather ins(%src, {maskPattern = #pto.mask_pattern<P0101>} : !pto.tile_buf<vec, 1x128xf32>, "row") outs(%dst : !pto.tile_buf<vec, 1x64xui32>)
    return
  }
}

//--- width.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 1x128xf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    pto.tgather ins(%src, {maskPattern = #pto.mask_pattern<P0101>} : !pto.tile_buf<vec, 1x128xf16>, "row") outs(%dst : !pto.tile_buf<vec, 1x64xf32>)
    return
  }
}

//--- integer16.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 1x128xi16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 1x64xi16>
    pto.tgather ins(%src, {maskPattern = #pto.mask_pattern<P0101>} : !pto.tile_buf<vec, 1x128xi16>, "row") outs(%dst : !pto.tile_buf<vec, 1x64xi16>)
    return
  }
}

//--- partial_valid.pto
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=96, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 1x48xf32>
    pto.tgather ins(%src, {maskPattern = #pto.mask_pattern<P0101>} : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=96, blayout=row_major, slayout=none_box, fractal=512, pad=0>, "row") outs(%dst : !pto.tile_buf<vec, 1x48xf32>)
    return
  }
}
