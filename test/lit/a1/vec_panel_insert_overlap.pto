// RUN: not ptoas --pto-arch=a1 %s -o /dev/null 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %row = arith.constant 0 : index
    %col = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<vec, 128x16xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 128x32xf32>
    pto.tinsert ins(%dst, %row, %col : !pto.tile_buf<vec, 128x32xf32>, index, index) outs(%dst : !pto.tile_buf<vec, 128x32xf32>)
    return
  }
}
// CHECK: A1 Vec insertion requires disjoint full row-major tiles and bounded aligned offsets
