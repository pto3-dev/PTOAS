// RUN: not ptoas --pto-arch=a1 %s -o /dev/null 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @bad() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 13x80xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 12x80xf32>
    pto.tmov ins(%src : !pto.tile_buf<vec, 13x80xf32>) outs(%dst : !pto.tile_buf<vec, 12x80xf32>)
    return
  }
}
// CHECK: non-mat tmov to use matching src/dst shapes
