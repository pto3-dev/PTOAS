// RUN: ptoas --pto-arch=a1 --plan-memory-impl=modern %s -o - | FileCheck %s
// RUN: ptoas --plan-memory-impl=legacy %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_col_broadcast_f16(%input: !pto.ptr<f16>, %output: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 80 : index
    %iv = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %ov = pto.make_tensor_view %output, shape = [%one, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %ip = pto.partition_view %iv, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x80xf16>
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%one, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x80xf16>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x80xf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 1x80xf16>
    pto.tload ins(%ip : !pto.partition_tensor_view<16x80xf16>) outs(%src : !pto.tile_buf<vec, 16x80xf16>)
    pto.tcolmax ins(%src : !pto.tile_buf<vec, 16x80xf16>) outs(%dst : !pto.tile_buf<vec, 1x80xf16>)
    %expanded = pto.alloc_tile : !pto.tile_buf<vec, 16x80xf16>
    pto.tcolexpand ins(%dst : !pto.tile_buf<vec, 1x80xf16>) outs(%expanded : !pto.tile_buf<vec, 16x80xf16>)
    return
  }
}
// CHECK: TCOLMAX(
// CHECK: TCOLEXPAND(
