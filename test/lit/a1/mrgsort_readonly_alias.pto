// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @readonly_merge() attributes {pto.entry} {
    %source_addr = arith.constant 0 : i64
    %result_addr = arith.constant 4096 : i64
    %scratch_addr = arith.constant 8192 : i64
    %source0 = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %source1 = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %source2 = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %source3 = pto.alloc_tile addr = %source_addr : !pto.tile_buf<vec, 1x32xf32>
    %result = pto.alloc_tile addr = %result_addr : !pto.tile_buf<vec, 1x128xf32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x1024xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tmrgsort ins(%source0, %source1, %source2, %source3, %scratch {exhausted = false} : !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x32xf32>, !pto.tile_buf<vec, 1x1024xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x128xf32>, vector<4xi16>)
    return
  }
}
// CHECK: TMRGSORT<
