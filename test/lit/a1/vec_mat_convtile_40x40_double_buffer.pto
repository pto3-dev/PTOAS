}

// CHECK-LABEL: a1_im2col_40x40(
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID[[LOAD0:[0-9]+]])
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID[[LOAD1:[0-9]+]])
// CHECK: wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID[[LOAD0]])
// CHECK-COUNT-25: TINSERT(
// CHECK: set_flag(PIPE_MTE3, PIPE_MTE1, EVENT_ID[[IMAGE:[0-9]+]])
// CHECK: wait_flag(PIPE_MTE3, PIPE_MTE1, EVENT_ID[[IMAGE]])
// CHECK: TIMG2COL<
// CHECK: TMATMUL(
