    %op = pto.partition_view %ov, offsets = [%m, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
    pto.timg2col %left, %image, pos_m = %m, pos_k = %c0 {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x576xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x4x40x40x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    pto.tmatmul ins(%left, %right : !pto.tile_buf<left, 16x576xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<right, 576x16xf16, blayout=row_major, slayout=col_major, fractal=512>) outs(%acc : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)
