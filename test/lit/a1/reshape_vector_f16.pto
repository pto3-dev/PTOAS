// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: ptoas %s -o - | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @a1_f16_reshape(%out: !pto.ptr<f16>, %input: !pto.ptr<f16>) attributes {pto.entry} {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %rows = arith.constant 16 : index
    %cols = arith.constant 16 : index
    %count = arith.constant 256 : index
    %in_view = pto.make_tensor_view %input, shape = [%rows, %cols], strides = [%cols, %one] : !pto.tensor_view<?x?xf16>
    %out_view = pto.make_tensor_view %out, shape = [%one, %count], strides = [%count, %one] : !pto.tensor_view<?x?xf16>
    %in_part = pto.partition_view %in_view, offsets = [%zero, %zero], sizes = [%rows, %cols] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<16x16xf16>
    %out_part = pto.partition_view %out_view, offsets = [%zero, %zero], sizes = [%one, %count] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<1x256xf16>
    %a = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%in_part : !pto.partition_tensor_view<16x16xf16>) outs(%a : !pto.tile_buf<vec, 16x16xf16>)
    %flat = pto.treshape %a : !pto.tile_buf<vec, 16x16xf16> -> !pto.tile_buf<vec, 1x256xf16>
    pto.tadd ins(%flat, %flat : !pto.tile_buf<vec, 1x256xf16>, !pto.tile_buf<vec, 1x256xf16>) outs(%flat : !pto.tile_buf<vec, 1x256xf16>)
    %back = pto.treshape %flat : !pto.tile_buf<vec, 1x256xf16> -> !pto.tile_buf<vec, 16x16xf16>
    %again = pto.treshape %back : !pto.tile_buf<vec, 16x16xf16> -> !pto.tile_buf<vec, 1x256xf16>
    pto.tstore ins(%again : !pto.tile_buf<vec, 1x256xf16>) outs(%out_part : !pto.partition_tensor_view<1x256xf16>)
    return
  }
}
// CHECK: a1_f16_reshape(
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_V,
// CHECK: TRESHAPE(
// CHECK: wait_flag(PIPE_MTE2, PIPE_V,
// CHECK: TADD(
// CHECK: set_flag(PIPE_V, PIPE_MTE3,
// CHECK: TRESHAPE(
// CHECK: TRESHAPE(
// CHECK: wait_flag(PIPE_V, PIPE_MTE3,
// CHECK: TSTORE(
