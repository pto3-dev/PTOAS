// RUN: ptoas --pto-arch=a1 --pto-level=level3 --enable-insert-sync %s -o - | FileCheck %s
// RUN: sed 's/arith.constant 0 : i64/arith.constant 1 : i64/' %s > %t.align.pto
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 --enable-insert-sync %t.align.pto -o - 2>&1 | FileCheck %s --check-prefix=REJECT
// RUN: sed 's/arith.constant 0 : i64/arith.constant 130048 : i64/' %s > %t.bounds.pto
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 --enable-insert-sync %t.bounds.pto -o - 2>&1 | FileCheck %s --check-prefix=REJECT

module attributes {pto.target_arch = "a1"} {
  func.func @a1_dynamic_slots(%input: !pto.ptr<f32>, %output: !pto.ptr<f32>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c5 = arith.constant 5 : index
    %c16 = arith.constant 16 : index
    %c80 = arith.constant 80 : index
    %c1024 = arith.constant 1024 : index
    %base = arith.constant 0 : i64
    %in_view = pto.make_tensor_view %input, shape = [%c80, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    %out_view = pto.make_tensor_view %output, shape = [%c80, %c16], strides = [%c16, %c1] : !pto.tensor_view<?x?xf32>
    scf.for %i = %c0 to %c5 step %c1 {
      %slot = arith.remsi %i, %c2 : index
      %slot_offset = arith.muli %slot, %c1024 : index
      %slot_i64 = arith.index_cast %slot_offset : index to i64
      %addr = arith.addi %base, %slot_i64 : i64
      %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<vec, 16x16xf32>
      %row = arith.muli %i, %c16 : index
      %in_part = pto.partition_view %in_view, offsets = [%row, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
      %out_part = pto.partition_view %out_view, offsets = [%row, %c0], sizes = [%c16, %c16] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x16xf32>
      pto.tload ins(%in_part : !pto.partition_tensor_view<16x16xf32>) outs(%tile : !pto.tile_buf<vec, 16x16xf32>)
      pto.tstore ins(%tile : !pto.tile_buf<vec, 16x16xf32>) outs(%out_part : !pto.partition_tensor_view<16x16xf32>)
    }
    return
  }
}
// CHECK-LABEL: a1_dynamic_slots(
// CHECK: TASSIGN(
// CHECK: TLOAD(
// CHECK: TSTORE(
// REJECT: A1 tile address must be bounded, aligned, and within the 128 KiB UB budget
