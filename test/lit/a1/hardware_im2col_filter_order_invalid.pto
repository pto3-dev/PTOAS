// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/empty.pto -o - 2>&1 | FileCheck %s --check-prefix=EMPTY
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/too_many.pto -o - 2>&1 | FileCheck %s --check-prefix=TOO_MANY
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/duplicate.pto -o - 2>&1 | FileCheck %s --check-prefix=DUPLICATE
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/negative.pto -o - 2>&1 | FileCheck %s --check-prefix=NEGATIVE
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/overflow.pto -o - 2>&1 | FileCheck %s --check-prefix=OVERFLOW
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/geometry.pto -o - 2>&1 | FileCheck %s --check-prefix=GEOMETRY
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/columns.pto -o - 2>&1 | FileCheck %s --check-prefix=COLUMNS
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/unaligned.pto -o - 2>&1 | FileCheck %s --check-prefix=UNALIGNED
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/past_group.pto -o - 2>&1 | FileCheck %s --check-prefix=PAST_GROUP
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/unbounded.pto -o - 2>&1 | FileCheck %s --check-prefix=UNBOUNDED
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/loop_alignment.pto -o - 2>&1 | FileCheck %s --check-prefix=LOOP_ALIGNMENT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/signed_height.pto -o - 2>&1 | FileCheck %s --check-prefix=SIGNED_HEIGHT
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/signed_output.pto -o - 2>&1 | FileCheck %s --check-prefix=SIGNED_OUTPUT
// RUN: not ptoas --pto-arch=a2 --pto-level=level1 %t/a2.pto -o - 2>&1 | FileCheck %s --check-prefix=A2
// RUN: not ptoas --pto-arch=a3 --pto-level=level1 %t/a3.pto -o - 2>&1 | FileCheck %s --check-prefix=A3
// RUN: not ptoas --pto-arch=a5 --pto-level=level1 %t/a5.pto -o - 2>&1 | FileCheck %s --check-prefix=A5
// RUN: not ptoas --pto-arch=a1 --pto-level=level1 %t/wrong_type.pto -o - 2>&1 | FileCheck %s --check-prefix=WRONG_TYPE
// RUN: ptoas --pto-arch=a1 --pto-level=level1 %t/aligned_loop.pto -o - | FileCheck %s --check-prefix=LOOP

// EMPTY: filter_order requires 1..127
// TOO_MANY: filter_order requires 1..127
// DUPLICATE: filter_order requires unique
// NEGATIVE: filter_order requires unique
// OVERFLOW: filter_order requires unique
// GEOMETRY: A1 filter_order tap is outside
// COLUMNS: filter_order requires Left columns
// UNALIGNED: A1 filter_order requires bounded K
// PAST_GROUP: A1 im2col requires bounded M and aligned bounded K windows
// UNBOUNDED: A1 im2col requires bounded M
// LOOP_ALIGNMENT: A1 filter_order requires bounded K
// SIGNED_HEIGHT: A1 filter_order requires signed 16-bit
// SIGNED_OUTPUT: A1 filter_order requires signed 16-bit
// A2: filter_order is supported only on A1
// A3: filter_order is supported only on A1
// A5: filter_order is supported only on A1
// WRONG_TYPE: attribute 'filter_order' failed to satisfy constraint
// LOOP: TIMG2COL<

//--- empty.pto
#cfg = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=48, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @filter_order() attributes {pto.entry} {
    %image = pto.alloc_tile {config = #cfg} : !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    %left = pto.alloc_tile : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>
    %k = arith.constant 288 : index
    pto.timg2col %left, %image, pos_k = %k filter_order = [] {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    return
  }
}

//--- too_many.pto
