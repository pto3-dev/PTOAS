    %left = pto.alloc_tile : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>
    %k = arith.constant 288 : index
    pto.timg2col %left, %image, pos_k = %dynamic filter_order = [0, 4, 8, 3, 7, 2] {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
