module attributes {pto.target_arch = "a5"} {
  func.func @filter_order() attributes {pto.entry} {
    %image = pto.alloc_tile {config = #cfg} : !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    %left = pto.alloc_tile : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>
    %k = arith.constant 288 : index
    pto.timg2col %left, %image, pos_k = %k filter_order = [0, 4, 8, 3, 7, 2] {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    return
  }
}

//--- wrong_type.pto
#cfg = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=48, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @filter_order() attributes {pto.entry} {
    %image = pto.alloc_tile {config = #cfg} : !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    %left = pto.alloc_tile : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>
    %k = arith.constant 288 : index
    "pto.timg2col"(%left, %image, %k) {operandSegmentSizes = array<i32: 1, 1, 0, 1>, fmatrixMode = #pto.fmatrix_mode<a_auto>, filter_order = array<i32: 0, 4, 8, 3, 7, 2>} : (!pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>, index) -> ()
    return
  }
}

//--- aligned_loop.pto
#cfg = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=48, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @filter_order() attributes {pto.entry} {
    %image = pto.alloc_tile {config = #cfg} : !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    %left = pto.alloc_tile : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>
    %lo = arith.constant 0 : index
    %hi = arith.constant 432 : index
    %step = arith.constant 144 : index
    scf.for %k = %lo to %hi step %step {
    pto.timg2col %left, %image, pos_k = %k filter_order = [0, 4, 8, 3, 7, 2] {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x96xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x3x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    }
    return
  }
}
