// RUN: sed 's/ addr = [^ ]*//g' %s > %t.pto
// RUN: ptoas --pto-arch=a1 --pto-level=level1 %t.pto -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %t.pto -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
// Planners own addresses at levels1/2; level3 consumes the explicit addresses.
module attributes {pto.target_arch = "a1"} {
  func.func @allocation_proven_full() {
    %source_rows = arith.constant 2304 : index
    %target_rows = arith.constant 144 : index
    %columns = arith.constant 32 : index
    %row = arith.constant 1776 : index
    %zero = arith.constant 0 : index
    %source_addr = arith.constant 512 : i64
    %target_addr = arith.constant 0 : i64
    %s = pto.alloc_tile addr = %source_addr valid_row = %source_rows valid_col = %columns : !pto.tile_buf<loc=mat, dtype=f16, rows=2304, cols=32, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %d = pto.alloc_tile addr = %target_addr valid_row = %target_rows valid_col = %columns : !pto.tile_buf<loc=right, dtype=f16, rows=144, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    pto.textract ins(%s, %row, %zero : !pto.tile_buf<loc=mat, dtype=f16, rows=2304, cols=32, v_row=?, v_col=?, blayout=col_major, slayout=row_major, fractal=512, pad=0>, index, index) outs(%d : !pto.tile_buf<loc=right, dtype=f16, rows=144, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=col_major, fractal=512, pad=0>) {block_step = 4 : i64}
    return
  }
}
// CHECK-LABEL: allocation_proven_full
// CHECK: TEXTRACT<4>(
