// RUN: ptoas --pto-arch=a1 --pto-level=level3 %s -o - | FileCheck %s
// RUN: sed 's/constant 256 : index/constant 192 : index/' %s > %t.bounds.pto
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t.bounds.pto -o - 2>&1 | FileCheck %s --check-prefix=BOUNDS
// RUN: sed 's/constant 8192 : index/constant 128000 : index/' %s > %t.address.pto
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t.address.pto -o - 2>&1 | FileCheck %s --check-prefix=ADDRESS

module attributes {pto.target_arch = "a1"} {
  func.func @a1_integer_dma_pipeline(%output: !pto.ptr<ui32>, %input: !pto.ptr<ui32>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %c256 = arith.constant 256 : index
    %bank_bytes = arith.constant 8192 : index
    %input_view = pto.make_tensor_view %input, shape = [%c256, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xui32>
    %output_view = pto.make_tensor_view %output, shape = [%c256, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xui32>
    scf.for %work = %c0 to %c4 step %c1 {
      %row = arith.muli %work, %c64 : index
      %bank = arith.remsi %work, %c2 : index
      %address = arith.muli %bank, %bank_bytes : index
      %address_i64 = arith.index_cast %address : index to i64
      %in_part = pto.partition_view %input_view, offsets = [%row, %c0], sizes = [%c64, %c32] : !pto.tensor_view<?x?xui32> -> !pto.partition_tensor_view<64x32xui32>
      %out_part = pto.partition_view %output_view, offsets = [%row, %c0], sizes = [%c64, %c32] : !pto.tensor_view<?x?xui32> -> !pto.partition_tensor_view<64x32xui32>
      %tile = pto.alloc_tile addr = %address_i64 : !pto.tile_buf<vec, 64x32xui32>
      pto.tload ins(%in_part : !pto.partition_tensor_view<64x32xui32>) outs(%tile : !pto.tile_buf<vec, 64x32xui32>)
      pto.tstore ins(%tile : !pto.tile_buf<vec, 64x32xui32>) outs(%out_part : !pto.partition_tensor_view<64x32xui32>)
    }
    return
  }
}
// CHECK: a1_integer_dma_pipeline(
// CHECK: for (
// CHECK: Tile<TileType::Vec, uint32_t, 64, 32,
// CHECK: TLOAD(
// CHECK: set_flag(PIPE_MTE2, PIPE_MTE3,
// CHECK: TSTORE(
// BOUNDS: A1 DMA partition must fit within its source tensor view
// ADDRESS: A1 tile address must be bounded, aligned, and within the 128 KiB UB budget.
