// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source_address = arith.constant 0 : i64
    %source = pto.alloc_tile addr = %source_address : !pto.tile_buf<vec, 8x80xf32>
    %indices_address = arith.constant 4096 : i64
    %indices = pto.alloc_tile addr = %indices_address : !pto.tile_buf<vec, 8x96xi32>
    %result_address = arith.constant 16384 : i64
    %result = pto.alloc_tile addr = %result_address : !pto.tile_buf<vec, 8x96xf32>
    pto.tgather ins(%source, %indices : !pto.tile_buf<vec, 8x80xf32>, !pto.tile_buf<vec, 8x96xi32>) outs(%result : !pto.tile_buf<vec, 8x96xf32>)
    return
  }
}
// CHECK: requires explicit tmp when PlanMemory is skipped
