// RUN: ptoas --pto-arch=a1 --emit-pto-ir %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s --check-prefix=CPP
module attributes {pto.target_arch = "a1"} {
  func.func @probe() attributes {pto.entry} {
    %source = pto.alloc_tile : !pto.tile_buf<vec, 1x1024xf32>
    %indices = pto.alloc_tile : !pto.tile_buf<vec, 1x1024xui32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x2048xf32>
    pto.tsort32 ins(%source, %indices : !pto.tile_buf<vec, 1x1024xf32>, !pto.tile_buf<vec, 1x1024xui32>) outs(%result : !pto.tile_buf<vec, 1x2048xf32>)
    return
  }
}
// CHECK: !pto.tile_buf<vec, 1x4096xf32>
// CHECK: pto.tsort32
// CPP: TSORT32(
