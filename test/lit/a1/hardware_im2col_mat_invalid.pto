    pto.timg2col %left, %image {fmatrixMode = #pto.fmatrix_mode<a_auto>, config = #image_config} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf32, blayout=col_major, slayout=row_major, fractal=512>
