//--- ambiguous.pto
#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%image: !pto.conv_tile_buf<mat, 1x2x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>, %left: !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>) {
    pto.timg2col %left, %image {fmatrixMode = #pto.fmatrix_mode<a_auto>, config = #image_config} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.conv_tile_buf<mat, 1x2x4x4x16xf16, layout=#pto.conv_layout<nc1hwc0>>
    return
  }
}

//--- duplicate_position.pto
#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%image: !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %left: !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>) {
    %offset = arith.constant 0 : index
    pto.timg2col %left, %image, pos_k = %offset, pos_k = %offset {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    return
  }
}


//--- unknown_position.pto
#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%image: !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %left: !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>) {
    %offset = arith.constant 0 : index
    pto.timg2col %left, %image, pos_x = %offset {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    return
  }
}
