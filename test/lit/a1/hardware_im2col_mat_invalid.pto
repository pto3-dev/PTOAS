    %offset = arith.constant 1 : index
    pto.timg2col %left, %image, pos_k = %offset {fmatrixMode = #pto.fmatrix_mode<a_auto>, config = #image_config} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
