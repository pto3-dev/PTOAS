// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/missing.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING
// MISSING: Mat image config must match
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/geometry.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=GEOMETRY
// GEOMETRY: Mat image config must match
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/channels.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=CHANNELS
// CHANNELS: Mat image config must match
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/layout.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=LAYOUT
// LAYOUT: Mat image requires a complete aligned FP16 NZ Mat tile
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/partial.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=PARTIAL
// PARTIAL: Mat image requires a complete aligned FP16 NZ Mat tile
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/dtype.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=DTYPE
// DTYPE: Mat image requires a complete aligned FP16 NZ Mat tile
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/space.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=SPACE
// SPACE: Mat image requires a complete aligned FP16 NZ Mat tile
// RUN: not ptoas --pto-arch=a3 --pto-level=level3 %t/arch.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=ARCH
// ARCH: Mat image sources are supported only on A1
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/mode.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=MODE
// MODE: A1 Mat im2col requires config and automatic FMATRIX A
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/mwindow.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=MWINDOW
// MWINDOW: A1 im2col requires bounded M and aligned bounded K windows
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/kwindow.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=KWINDOW
// KWINDOW: A1 im2col requires bounded M and aligned bounded K windows
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/kalign.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=KALIGN
// KALIGN: A1 im2col requires bounded M and aligned bounded K windows
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/ambiguous.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=AMBIGUOUS
// AMBIGUOUS: ConvTile sources take config from their allocation

// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/duplicate_position.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=DUPLICATE
// DUPLICATE: duplicate pos_k operand
// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %t/unknown_position.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=UNKNOWN
// UNKNOWN: expected 'pos_m' or 'pos_k'

//--- missing.pto
#image_config = #pto.conv_tile_config<fmap_h=4, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%image: !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %left: !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>) {
    pto.timg2col %left, %image {fmatrixMode = #pto.fmatrix_mode<a_auto>} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    return
  }
}

//--- geometry.pto
#image_config = #pto.conv_tile_config<fmap_h=3, fmap_w=4, pad_list=1x1x1x1, filter_h=3, filter_w=3, dilation_h=1, dilation_w=1, stride_h=1, stride_w=1, pad_value=0 : i32, channel_size=32, repeat_stride=0, repeat_time=1, repeat_mode=0, dst_stride=0, dst_mposition=0, transpose=false>
module attributes {pto.target_arch = "a1"} {
  func.func @bad(%image: !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>, %left: !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>) {
    pto.timg2col %left, %image {fmatrixMode = #pto.fmatrix_mode<a_auto>, config = #image_config} : !pto.tile_buf<left, 16x288xf16, blayout=row_major, slayout=row_major, fractal=512>, !pto.tile_buf<mat, 16x32xf16, blayout=col_major, slayout=row_major, fractal=512>
    return
  }
}

