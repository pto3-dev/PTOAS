// RUN: not ptoas --pto-arch=a1 --pto-level=level3 %s 2>&1 | FileCheck %s
module attributes {pto.target_arch = "a1"} {
  func.func @convert() {
    %a0 = arith.constant 0 : i64
    %a32 = arith.constant 32 : i64
    %a64 = arith.constant 64 : i64
    %src = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 1x16xf32>
    %dst = pto.alloc_tile addr = %a64 : !pto.tile_buf<vec, 1x16xf32>
    pto.tcvt ins(%src {rmode = #pto<round_mode NONE>, satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x16xf32>) outs(%dst : !pto.tile_buf<vec, 1x16xf32>)
    return
  }
}
// CHECK: A1 conversion requires an FP16/FP32 Vec pair
