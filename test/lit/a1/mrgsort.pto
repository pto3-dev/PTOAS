// RUN: ptoas --pto-arch=a1 %s -o - | FileCheck %s
// RUN: ptoas %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --pto-level=level2 %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a1 --enable-insert-sync --pto-insert-sync-debug=2 %s -o - 2>&1 | FileCheck %s --check-prefix=MODEL
module attributes {pto.target_arch = "a1"} {
  func.func @a1_mrgsort(%output: !pto.ptr<f32>, %input0: !pto.ptr<f32>, %input1: !pto.ptr<f32>, %input2: !pto.ptr<f32>, %input3: !pto.ptr<f32>) -> vector<4xi16> {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %source_col = arith.constant 16 : index
    %cols0 = arith.constant 64 : index
    %cols1 = arith.constant 96 : index
    %output_cols = arith.constant 160 : index
    %input_stride = arith.constant 128 : index
    %output_stride = arith.constant 192 : index
    %view0 = pto.make_tensor_view %input0, shape = [%one, %input_stride], strides = [%input_stride, %one] : !pto.tensor_view<?x?xf32>
    %view1 = pto.make_tensor_view %input1, shape = [%one, %input_stride], strides = [%input_stride, %one] : !pto.tensor_view<?x?xf32>
    %view_out = pto.make_tensor_view %output, shape = [%one, %output_stride], strides = [%output_stride, %one] : !pto.tensor_view<?x?xf32>
    %part0 = pto.partition_view %view0, offsets = [%zero, %source_col], sizes = [%one, %cols0] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x64xf32>
    %part1 = pto.partition_view %view1, offsets = [%zero, %source_col], sizes = [%one, %cols1] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x96xf32>
    %part_out = pto.partition_view %view_out, offsets = [%zero, %source_col], sizes = [%one, %output_cols] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x160xf32>
    %source0 = pto.alloc_tile : !pto.tile_buf<vec, 1x64xf32>
    %source1 = pto.alloc_tile : !pto.tile_buf<vec, 1x96xf32>
    %result = pto.alloc_tile : !pto.tile_buf<vec, 1x160xf32>
    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 1x1280xf32>
    %counts = arith.constant dense<0> : vector<4xi16>
    pto.tload ins(%part0 : !pto.partition_tensor_view<1x64xf32>) outs(%source0 : !pto.tile_buf<vec, 1x64xf32>)
    pto.tload ins(%part1 : !pto.partition_tensor_view<1x96xf32>) outs(%source1 : !pto.tile_buf<vec, 1x96xf32>)
    pto.tload ins(%part_out : !pto.partition_tensor_view<1x160xf32>) outs(%result : !pto.tile_buf<vec, 1x160xf32>)
    // EXTRA-SOURCES
    pto.tmrgsort ins(%source0, %source1, %scratch {exhausted = true} : !pto.tile_buf<vec, 1x64xf32>, !pto.tile_buf<vec, 1x96xf32>, !pto.tile_buf<vec, 1x1280xf32>) outs(%result, %counts : !pto.tile_buf<vec, 1x160xf32>, vector<4xi16>)
    pto.tstore ins(%result : !pto.tile_buf<vec, 1x160xf32>) outs(%part_out : !pto.partition_tensor_view<1x160xf32>)
    return %counts : vector<4xi16>
  }
}
// CHECK: AICORE pto::MrgSortExecutedNumList a1_mrgsort(
// CHECK: TLOAD(
// CHECK-DAG: set_flag(PIPE_MTE2, PIPE_V,
// CHECK-DAG: wait_flag(PIPE_MTE2, PIPE_V,
// CHECK-DAG: set_flag(PIPE_MTE2, PIPE_S,
// CHECK-DAG: wait_flag(PIPE_MTE2, PIPE_S,
// CHECK: TMRGSORT<
// CHECK: set_flag(PIPE_S, PIPE_MTE3,
// CHECK: wait_flag(PIPE_S, PIPE_MTE3,
// CHECK: TSTORE(
// CHECK: return
// MODEL-LABEL: After Sync Motion
// MODEL: COMPOUND pto.tmrgsort [PIPE_S]
// MODEL: COMPOUND pto.tmrgsort [PIPE_V]
// MODEL: COMPOUND pto.tmrgsort [PIPE_S]
// MODEL: COMPOUND pto.tmrgsort [PIPE_V]
