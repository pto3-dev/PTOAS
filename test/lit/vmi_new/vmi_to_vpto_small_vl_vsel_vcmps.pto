// GitHub issues #1376 and #1381 regression matrix (VMI-level, sub-physical VL).
//
// #1376: pto.vmi.vsel with non-4-byte dtypes at vl in {64, 128} (vl*byte<256)
// used to fail VPTO emission: the vector was lane-expanded to fill the 256B
// physical register while create_mask kept the logical lane count, so vsel saw
// a b32 mask against the expanded vreg. The lowering must pair every expanded
// vector with a mask whose granularity matches the element type.
//
// #1381: pto.vmi.vcmp / pto.vmi.vcmps with 8/16-bit elements at sub-physical VL
// used to lower the seed mask to a hard-coded b32. The seed and result masks
// must carry the element-derived granularity (b8 / b16).
//
// Both paths now lower cleanly; this file pins the complete failing matrix
// plus the passing controls (f16 vl128 = full physical VL; si32 vl64 = b32).
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --implicit-check-not=pto.vmi.
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --implicit-check-not=pto.vmi. --implicit-check-not=!pto.vmi.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vsel_f16_vl64(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f16, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %a = pto.vmi.vload %src[%c0] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<64xf16>
      %b = pto.vmi.vload %src[%c0] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<64xf16>
      %mask = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %a, %b
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xf16>, !pto.vmi.vreg<64xf16>
          -> !pto.vmi.vreg<64xf16>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xf16>, !pto.ptr<f16, ub>
    }
    return
  }
  func.func @vsel_si16_vl64(%src: !pto.ptr<si16, ub>, %dst: !pto.ptr<si16, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %a = pto.vmi.vload %src[%c0] : !pto.ptr<si16, ub> -> !pto.vmi.vreg<64xsi16>
      %b = pto.vmi.vload %src[%c0] : !pto.ptr<si16, ub> -> !pto.vmi.vreg<64xsi16>
      %mask = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %a, %b
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xsi16>, !pto.vmi.vreg<64xsi16>
          -> !pto.vmi.vreg<64xsi16>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xsi16>, !pto.ptr<si16, ub>
    }
    return
  }
  func.func @vsel_si8_vl64(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %a = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<64xsi8>
      %b = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<64xsi8>
      %mask = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %a, %b
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xsi8>, !pto.vmi.vreg<64xsi8>
          -> !pto.vmi.vreg<64xsi8>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xsi8>, !pto.ptr<si8, ub>
    }
    return
  }
  func.func @vsel_si8_vl128(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c90 = arith.constant 90 : index
    pto.vecscope {
      %a = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<128xsi8>
      %b = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<128xsi8>
      %mask = pto.vmi.create_mask %c90 : index -> !pto.vmi.mask<128xpred>
      %r = pto.vmi.vsel %mask, %a, %b
          : !pto.vmi.mask<128xpred>, !pto.vmi.vreg<128xsi8>, !pto.vmi.vreg<128xsi8>
          -> !pto.vmi.vreg<128xsi8>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<128xsi8>, !pto.ptr<si8, ub>
    }
    return
  }
  func.func @vsel_f16_vl128_control(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f16, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c90 = arith.constant 90 : index
    pto.vecscope {
      %a = pto.vmi.vload %src[%c0] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<128xf16>
      %b = pto.vmi.vload %src[%c0] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<128xf16>
      %mask = pto.vmi.create_mask %c90 : index -> !pto.vmi.mask<128xpred>
      %r = pto.vmi.vsel %mask, %a, %b
          : !pto.vmi.mask<128xpred>, !pto.vmi.vreg<128xf16>, !pto.vmi.vreg<128xf16>
          -> !pto.vmi.vreg<128xf16>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<128xf16>, !pto.ptr<f16, ub>
    }
    return
  }
  func.func @vcmps_si8_vl64(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>, %scalar: si8) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<64xsi8>
      %f = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<64xsi8>
      %seed = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %mask = pto.vmi.vcmps %s, %scalar, %seed {cmp = "eq"}
          : !pto.vmi.vreg<64xsi8>, si8, !pto.vmi.mask<64xpred> -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %s, %f
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xsi8>, !pto.vmi.vreg<64xsi8>
          -> !pto.vmi.vreg<64xsi8>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xsi8>, !pto.ptr<si8, ub>
    }
    return
  }
  func.func @vcmps_si16_vl64(%src: !pto.ptr<si16, ub>, %dst: !pto.ptr<si16, ub>, %scalar: si16) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%c0] : !pto.ptr<si16, ub> -> !pto.vmi.vreg<64xsi16>
      %f = pto.vmi.vload %src[%c0] : !pto.ptr<si16, ub> -> !pto.vmi.vreg<64xsi16>
      %seed = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %mask = pto.vmi.vcmps %s, %scalar, %seed {cmp = "eq"}
          : !pto.vmi.vreg<64xsi16>, si16, !pto.vmi.mask<64xpred> -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %s, %f
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xsi16>, !pto.vmi.vreg<64xsi16>
          -> !pto.vmi.vreg<64xsi16>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xsi16>, !pto.ptr<si16, ub>
    }
    return
  }
  func.func @vcmps_bf16_vl64(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<bf16, ub>, %scalar: bf16) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%c0] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<64xbf16>
      %f = pto.vmi.vload %src[%c0] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<64xbf16>
      %seed = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %mask = pto.vmi.vcmps %s, %scalar, %seed {cmp = "eq"}
          : !pto.vmi.vreg<64xbf16>, bf16, !pto.vmi.mask<64xpred> -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %s, %f
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xbf16>, !pto.vmi.vreg<64xbf16>
          -> !pto.vmi.vreg<64xbf16>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
    }
    return
  }
  func.func @vcmp_si8_vl64(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<64xsi8>
      %f = pto.vmi.vload %src[%c0] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<64xsi8>
      %seed = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %mask = pto.vmi.vcmp %s, %f, %seed {cmp = "eq"}
          : !pto.vmi.vreg<64xsi8>, !pto.vmi.vreg<64xsi8>, !pto.vmi.mask<64xpred>
          -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %s, %f
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xsi8>, !pto.vmi.vreg<64xsi8>
          -> !pto.vmi.vreg<64xsi8>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xsi8>, !pto.ptr<si8, ub>
    }
    return
  }
  func.func @vcmp_ui16_vl64(%src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui16, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%c0] : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<64xui16>
      %f = pto.vmi.vload %src[%c0] : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<64xui16>
      %seed = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %mask = pto.vmi.vcmp %s, %f, %seed {cmp = "eq"}
          : !pto.vmi.vreg<64xui16>, !pto.vmi.vreg<64xui16>, !pto.vmi.mask<64xpred>
          -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %s, %f
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xui16>, !pto.vmi.vreg<64xui16>
          -> !pto.vmi.vreg<64xui16>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xui16>, !pto.ptr<ui16, ub>
    }
    return
  }
  func.func @vcmps_si32_vl64_control(%src: !pto.ptr<si32, ub>, %dst: !pto.ptr<si32, ub>, %scalar: si32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c42 = arith.constant 42 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%c0] : !pto.ptr<si32, ub> -> !pto.vmi.vreg<64xsi32>
      %f = pto.vmi.vload %src[%c0] : !pto.ptr<si32, ub> -> !pto.vmi.vreg<64xsi32>
      %seed = pto.vmi.create_mask %c42 : index -> !pto.vmi.mask<64xpred>
      %mask = pto.vmi.vcmps %s, %scalar, %seed {cmp = "eq"}
          : !pto.vmi.vreg<64xsi32>, si32, !pto.vmi.mask<64xpred> -> !pto.vmi.mask<64xpred>
      %r = pto.vmi.vsel %mask, %s, %f
          : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xsi32>, !pto.vmi.vreg<64xsi32>
          -> !pto.vmi.vreg<64xsi32>
      pto.vmi.vstore %r, %dst[%c0] : !pto.vmi.vreg<64xsi32>, !pto.ptr<si32, ub>
    }
    return
  }
}

// CHECK-LABEL: func.func @vsel_f16_vl64(
// CHECK: pto.vsel {{.*}} : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
// CHECK-LABEL: func.func @vsel_si16_vl64(
// CHECK: pto.vsel {{.*}} : !pto.vreg<128xsi16>, !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<128xsi16>
// CHECK-LABEL: func.func @vsel_si8_vl64(
// CHECK: pto.vsel {{.*}} : !pto.vreg<256xsi8>, !pto.vreg<256xsi8>, !pto.mask<b8> -> !pto.vreg<256xsi8>
// CHECK-LABEL: func.func @vsel_si8_vl128(
// CHECK: pto.vsel {{.*}} : !pto.vreg<256xsi8>, !pto.vreg<256xsi8>, !pto.mask<b8> -> !pto.vreg<256xsi8>
// CHECK-LABEL: func.func @vsel_f16_vl128_control(
// CHECK: pto.vsel {{.*}} : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
// CHECK-LABEL: func.func @vcmps_si8_vl64(
// CHECK: pto.vcmp {{.*}} "eq" : !pto.vreg<256xsi8>, !pto.vreg<256xsi8>, !pto.mask<b8> -> !pto.mask<b8>
// CHECK-LABEL: func.func @vcmps_si16_vl64(
// CHECK: pto.vcmp {{.*}} "eq" : !pto.vreg<128xsi16>, !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.mask<b16>
// CHECK-LABEL: func.func @vcmps_bf16_vl64(
// CHECK: pto.vcmp {{.*}} "eq" : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.mask<b16> -> !pto.mask<b16>
// CHECK-LABEL: func.func @vcmp_si8_vl64(
// CHECK: pto.vcmp {{.*}} "eq" : !pto.vreg<256xsi8>, !pto.vreg<256xsi8>, !pto.mask<b8> -> !pto.mask<b8>
// CHECK-LABEL: func.func @vcmp_ui16_vl64(
// CHECK: pto.vcmp {{.*}} "eq" : !pto.vreg<128xui16>, !pto.vreg<128xui16>, !pto.mask<b16> -> !pto.mask<b16>
// CHECK-LABEL: func.func @vcmps_si32_vl64_control(
// CHECK: pto.vcmp {{.*}} "eq" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
