// RUN: not ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

// bf16 has no hardware VCI form: the instruction reads the base scalar as a
// byte index, and there is no usable bare `vci` at bf16 width.  The three
// index-generation ops therefore reject it, so it never reaches the lowering
// as a type that would need a synthesized ramp.
//
// One op per file: `ptoas` stops at the first module whose verifier fails, so
// several modules in one file would not reliably report every diagnostic.
module {
  func.func @vmi_iota_bf16_rejected(%base: bf16) {
    %value = pto.vmi.iota %base
        : bf16 -> !pto.vmi.vreg<128xbf16>
    return
  }
}

// CHECK: 'pto.vmi.iota' op requires result element type to be integer 8/16/32 or f16/f32; bf16 has no VCI form
