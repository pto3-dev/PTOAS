// RUN: split-file %s %t
// RUN: pto-test-opt %t/bf16_full.pto -verify-diagnostics
// RUN: not ptoas %t/bf16_full.pto --pto-arch=a5 --pto-backend=vpto --emit-vpto -o /dev/null 2>&1 | FileCheck %s
// RUN: pto-test-opt %t/bf16_group.pto -verify-diagnostics
// RUN: not ptoas %t/bf16_group.pto --pto-arch=a5 --pto-backend=vpto --emit-vpto -o /dev/null 2>&1 | FileCheck %s
// RUN: pto-test-opt %t/bf16_singleton.pto -verify-diagnostics
// RUN: not ptoas %t/bf16_singleton.pto --pto-arch=a5 --pto-backend=vpto --emit-vpto -o /dev/null 2>&1 | FileCheck %s
// RUN: pto-test-opt %t/bf16_no_reassoc.pto -verify-diagnostics
// RUN: not ptoas %t/bf16_no_reassoc.pto --pto-arch=a5 --pto-backend=vpto --emit-vpto -o /dev/null 2>&1 | FileCheck %s

// CHECK: error: 'pto.vmi.vcadd' op requires 16-bit or 32-bit integer, f16, or f32 VMI source element type

//--- bf16_full.pto
module {
  func.func @bf16_full(%source: !pto.vmi.vreg<64xbf16>,
      %mask: !pto.vmi.mask<64xpred>) -> !pto.vmi.vreg<1xbf16> {
    // expected-error@+1 {{requires 16-bit or 32-bit integer, f16, or f32 VMI source element type}}
    %sum = pto.vmi.vcadd %source, %mask {reassoc}
        : !pto.vmi.vreg<64xbf16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xbf16>
    return %sum : !pto.vmi.vreg<1xbf16>
  }
}

//--- bf16_group.pto
module {
  func.func @bf16_group(%source: !pto.vmi.vreg<64xbf16>,
      %mask: !pto.vmi.mask<64xpred>) -> !pto.vmi.vreg<8xbf16> {
    // expected-error@+1 {{requires 16-bit or 32-bit integer, f16, or f32 VMI source element type}}
    %sum = pto.vmi.vcadd %source, %mask {group = 8, reassoc}
        : !pto.vmi.vreg<64xbf16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<8xbf16>
    return %sum : !pto.vmi.vreg<8xbf16>
  }
}

//--- bf16_singleton.pto
module {
  func.func @bf16_singleton(%source: !pto.vmi.vreg<8xbf16>,
      %mask: !pto.vmi.mask<8xpred>) -> !pto.vmi.vreg<8xbf16> {
    // expected-error@+1 {{requires 16-bit or 32-bit integer, f16, or f32 VMI source element type}}
    %sum = pto.vmi.vcadd %source, %mask {group = 8, reassoc}
        : !pto.vmi.vreg<8xbf16>, !pto.vmi.mask<8xpred> -> !pto.vmi.vreg<8xbf16>
    return %sum : !pto.vmi.vreg<8xbf16>
  }
}

//--- bf16_no_reassoc.pto
module {
  func.func @bf16_no_reassoc(%source: !pto.vmi.vreg<64xbf16>,
      %mask: !pto.vmi.mask<64xpred>) -> !pto.vmi.vreg<1xbf16> {
    // expected-error@+1 {{requires 16-bit or 32-bit integer, f16, or f32 VMI source element type}}
    %sum = pto.vmi.vcadd %source, %mask
        : !pto.vmi.vreg<64xbf16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xbf16>
    return %sum : !pto.vmi.vreg<1xbf16>
  }
}
