// RUN: not pto-test-opt %s --split-input-file 2>&1 | FileCheck %s

module {
  func.func @vload_dist_mode_removed(
      %src: !pto.ptr<f32, ub>, %offset: index) {
    %value = pto.vmi.vload %src[%offset] {dist_mode = "continuous"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    return
  }
}

// -----

module {
  func.func @vstore_dist_mode_removed(
      %value: !pto.vmi.vreg<64xf32>, %dst: !pto.ptr<f32, ub>,
      %offset: index) {
    pto.vmi.vstore %value, %dst[%offset] {dist_mode = "intlv"}
        : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
    return
  }
}

// CHECK: 'pto.vmi.vload' op dist_mode is no longer supported
// CHECK: 'pto.vmi.vstore' op dist_mode is no longer supported
