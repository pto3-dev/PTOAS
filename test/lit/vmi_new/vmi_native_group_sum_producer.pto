// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vpack --implicit-check-not=pto.vmi.

// An explicitly assigned native result can leave the producer unchanged.
// The companion consumer test checks automatic layout assignment.
module {
  // ASSIGN-LABEL: func.func @vcadd_i16_vl128_g8(
  // ASSIGN: pto.vmi.group_reduce_addi {{.*}} -> !pto.vmi.vreg<8xi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  // LOWER-LABEL: func.func @vcadd_i16_vl128_g8(
  // LOWER: pto.vcgadd
  // LOWER: return
  func.func @vcadd_i16_vl128_g8(%x: !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>, %mask: !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<8xi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %sum = pto.vmi.vcadd %x, %mask {group = 8} : !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<8xi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    return %sum : !pto.vmi.vreg<8xi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  }

  // ASSIGN-LABEL: func.func @vcadd_si16_vl64_g8(
  // ASSIGN: pto.vmi.group_reduce_addi {{.*}} -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  // LOWER-LABEL: func.func @vcadd_si16_vl64_g8(
  // LOWER: pto.vcgadd
  // LOWER: return
  func.func @vcadd_si16_vl64_g8(%x: !pto.vmi.vreg<64xsi16, #pto.vmi.layout<contiguous, lane_stride = 2>>, %mask: !pto.vmi.mask<64xb16, #pto.vmi.layout<contiguous, lane_stride = 2>>) -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %sum = pto.vmi.vcadd %x, %mask {group = 8} : !pto.vmi.vreg<64xsi16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.vmi.mask<64xb16, #pto.vmi.layout<contiguous, lane_stride = 2>> -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    return %sum : !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  }

  // ASSIGN-LABEL: func.func @vcadd_ui16_vl256_g8(
  // ASSIGN: pto.vmi.group_reduce_addi {{.*}} -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  // LOWER-LABEL: func.func @vcadd_ui16_vl256_g8(
  // LOWER: pto.vcgadd
  // LOWER: return
  func.func @vcadd_ui16_vl256_g8(%x: !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>, %mask: !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>>) -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %sum = pto.vmi.vcadd %x, %mask {group = 8} : !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    return %sum : !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  }

  // ASSIGN-LABEL: func.func @vcadd_si16_vl512_g8(
  // ASSIGN: pto.vmi.group_reduce_addi {{.*}} -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  // LOWER-LABEL: func.func @vcadd_si16_vl512_g8(
  // LOWER: pto.vcgadd
  // LOWER: return
  func.func @vcadd_si16_vl512_g8(%x: !pto.vmi.vreg<512xsi16, #pto.vmi.layout<deinterleaved = 4>>, %mask: !pto.vmi.mask<512xb16, #pto.vmi.layout<deinterleaved = 4>>) -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %sum = pto.vmi.vcadd %x, %mask {group = 8} : !pto.vmi.vreg<512xsi16, #pto.vmi.layout<deinterleaved = 4>>, !pto.vmi.mask<512xb16, #pto.vmi.layout<deinterleaved = 4>> -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    return %sum : !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  }

  // ASSIGN-LABEL: func.func @vcadd_ui16_vl256_g16(
  // ASSIGN: pto.vmi.group_reduce_addi {{.*}} -> !pto.vmi.vreg<16xui16, #pto.vmi.layout<num_groups = 16, slots = 8, lane_stride = 2>>
  // LOWER-LABEL: func.func @vcadd_ui16_vl256_g16(
  // LOWER: pto.vcgadd
  // LOWER: return
  func.func @vcadd_ui16_vl256_g16(%x: !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>, %mask: !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<16xui16, #pto.vmi.layout<num_groups = 16, slots = 8, lane_stride = 2>> {
