// RUN: pto-test-opt %s -verify-diagnostics

module {
  func.func @vmi_vmula_i8_invalid(
      %acc: !pto.vmi.vreg<256xi8>, %lhs: !pto.vmi.vreg<256xi8>,
      %rhs: !pto.vmi.vreg<256xi8>, %mask: !pto.vmi.mask<256xpred>)
      -> !pto.vmi.vreg<256xi8> {
    // expected-error@+1 {{'pto.vmi.vmula' op requires f16, bf16, f32, i16, or i32 VMI element type; A5 does not support i8/u8 vmula}}
    %result = pto.vmi.vmula %acc, %lhs, %rhs, %mask
        : !pto.vmi.vreg<256xi8>, !pto.vmi.vreg<256xi8>, !pto.vmi.vreg<256xi8>,
          !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<256xi8>
    return %result : !pto.vmi.vreg<256xi8>
  }
}
