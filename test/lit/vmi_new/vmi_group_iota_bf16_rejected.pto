// RUN: not ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

// See `vmi_iota_bf16_rejected.pto` for why bf16 is rejected and why each op has
// its own file.
module {
  func.func @vmi_group_iota_bf16_rejected(%base: bf16) {
    %value = pto.vmi.group_iota %base {order = "ASC", group = 2}
        : bf16 -> !pto.vmi.vreg<128xbf16>
    return
  }
}

// CHECK: 'pto.vmi.group_iota' op requires result element type to be integer 8/16/32 or f16/f32; bf16 has no VCI form
