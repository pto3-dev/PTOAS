// Emission-level coverage for pto.mte_l0c_l1 pre_quant destinations: the LLVM
// FIX.L0C.TO.L1 intrinsic is selected per (source, destination) element-type
// pair exactly like the UB and GM families (the emitter used to emit the f32
// form for every destination). The full probe matrix lives in
// acc_store_gm_pre_quant_vpto_llvm.pto; this file pins the L1 family stem with
// a representative subset.

// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-before=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=ROUNDTRIP
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 || true ) | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @l1_pre_quant_probes(%src_f32: !pto.ptr<f32, l0c>,
                                 %src_i32: !pto.ptr<i32, l0c>,
                                 %dst_bf16: !pto.ptr<bf16, l1>,
                                 %dst_f16: !pto.ptr<f16, l1>,
                                 %dst_f32: !pto.ptr<f32, l1>,
                                 %dst_i32: !pto.ptr<i32, l1>,
                                 %scale: !pto.ptr<f32, scaling>) attributes {pto.kernel} {
    %c16_i64 = arith.constant 16 : i64
    %c32_i64 = arith.constant 32 : i64
    %c1_bf16 = arith.constant 1.000000e+00 : bf16

    // f32 accumulator -> bf16, scalar pre_quant.
    pto.mte_l0c_l1 %src_f32, %dst_bf16, %c16_i64, %c16_i64, %c16_i64, %c32_i64,
      pre_quant(%c1_bf16, mode = f32_bf16),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<bf16, l1>, i64, i64, i64, i64,
        bf16

    // f32 accumulator -> f16, vector pre_quant.
    pto.mte_l0c_l1 %src_f32, %dst_f16, %c16_i64, %c16_i64, %c16_i64, %c32_i64,
      pre_quant(%scale, mode = qf322f16_pre_vec),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<f16, l1>, i64, i64, i64, i64,
        !pto.ptr<f32, scaling>

    // f32 accumulator -> f32, vector pre_quant.
    pto.mte_l0c_l1 %src_f32, %dst_f32, %c16_i64, %c16_i64, %c16_i64, %c32_i64,
      pre_quant(%scale, mode = qf322f32_pre_vec),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<f32, l1>, i64, i64, i64, i64,
        !pto.ptr<f32, scaling>

    // i32 accumulator -> i32, vector pre_quant (deqs32_int).
    pto.mte_l0c_l1 %src_i32, %dst_i32, %c16_i64, %c16_i64, %c16_i64, %c32_i64,
      pre_quant(%scale, mode = deqs32_int_vec),
      nz2nd
      : !pto.ptr<i32, l0c>, !pto.ptr<i32, l1>, i64, i64, i64, i64,
        !pto.ptr<f32, scaling>
    return
  }
}

// ROUNDTRIP-LABEL: func.func @l1_pre_quant_probes(
// ROUNDTRIP: pre_quant(%{{.*}}, mode = f32_bf16)
// ROUNDTRIP: pre_quant(%{{.*}}, mode = qf322f16_pre_vec)
// ROUNDTRIP: pre_quant(%{{.*}}, mode = qf322f32_pre_vec)
// ROUNDTRIP: pre_quant(%{{.*}}, mode = deqs32_int_vec)

// EXPAND-LABEL: func.func @l1_pre_quant_probes(
// EXPAND: pto.set_quant_pre
// EXPAND: pto.copy_matrix_cc_to_cbuf
// EXPAND: pto.set_fpc
// EXPAND: pto.copy_matrix_cc_to_cbuf
// EXPAND: pto.set_fpc
// EXPAND: pto.copy_matrix_cc_to_cbuf
// EXPAND: pto.set_fpc
// EXPAND: pto.copy_matrix_cc_to_cbuf

// CHECK-LABEL: llvm.func @l1_pre_quant_probes_mix_aic
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.L1.f322bf16.EXT
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.L1.f322f16.EXT
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.L1.f32.EXT
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.L1.s32.EXT
