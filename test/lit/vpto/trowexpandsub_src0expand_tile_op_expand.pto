// Test that ExpandTileOp + InlineLibCall + FoldTileBufIntrinsics pipeline
// expands pto.trowexpandsub when the row-expanded operand is *src0* (src1 matches dst),
// i.e. pto-isa's src1eqdst branch of include/pto/cpu/TRowExpandOp.hpp.
//
// Pipeline: ExpandTileOp -> InlineLibCall -> FoldTileBufIntrinsics
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - 2>/dev/null | FileCheck %s

// src0 is RowMajor with 32/sizeof(f32) = 8 columns per row, so its 32-byte block
// repeats across the row and the result keeps the authored operand order:
// dst[i, j] = src0[i, j % 8] - src1[i, j].
// CHECK: func.func @TROWEXPANDSUB_SRC0
// CHECK-NOT: pto.trowexpandsub ins
// CHECK: pto.vecscope
// CHECK: pto.vlds
// CHECK: [[BLK:%.*]] = pto.vlds {{.*}} {dist = "BRC_BLK"}
// CHECK-NOT: pto.vdup
// CHECK: pto.vsub [[BLK]],
// CHECK: pto.vsts

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TROWEXPANDSUB_SRC0() {
    // src0: 32x8 row-major expanded operand (32/sizeof(f32) = 8 columns per row)
    %src0 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=8, v_row=32, v_col=8,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // src1: 32x32 full-sized operand (its valid shape matches dst)
    %src1 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // dst: 32x32 result (row-major)
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.trowexpandsub ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=8, v_row=32, v_col=8,
                                   blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                               !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32,
                                   blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                       outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32,
                                   blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
