// Test that ExpandTileOp + InlineLibCall + FoldTileBufIntrinsics pipeline
// expands pto.tcolexpandsub when the broadcast row is *src0* (src1 matches dst),
// i.e. pto-isa's src1eqdst branch of include/pto/npu/a5/TColExpandBinOp.hpp.
//
// Pipeline: ExpandTileOp -> InlineLibCall -> FoldTileBufIntrinsics
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - 2>/dev/null | FileCheck %s

// src0 carries the single row broadcast down every column, and the result keeps the
// authored operand order: dst[i, j] = src0[0, j] - src1[i, j].
// CHECK: func.func @TCOLEXPANDSUB_SRC0
// CHECK-NOT: pto.tcolexpandsub ins
// CHECK: pto.vecscope
// CHECK: [[SWEPT:%.*]] = pto.vlds
// CHECK: [[BCAST:%.*]] = pto.vlds {{.*}}[%c0]
// CHECK-NOT: pto.vdup
// CHECK: pto.vsub [[BCAST]],
// CHECK: pto.vsts

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TCOLEXPANDSUB_SRC0() {
    // src0: the 1x64 row that is broadcast (row-major)
    %src0 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // src1: 16x64 full-sized operand (its valid shape matches dst)
    %src1 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // dst: 16x64 result (row-major)
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tcolexpandsub ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64,
                               blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                           !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                               blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                                    blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
